<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cetakpemakaian" pageWidth="595" pageHeight="1000" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="dc16ac77-ba85-4c05-87fe-8ab269570601">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="0"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="1000"/>
	<parameter name="namaRS" class="java.lang.String"/>
	<parameter name="gambarLogo" class="java.awt.Image"/>
	<parameter name="alamatRS" class="java.lang.String"/>
	<parameter name="norec" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT        pd.norec, pasien_m.nocm, pasien_m.namapasien,to_char(pasien_m.tgllahir, 'DD-MM-YYYY' ) AS tgllahir, jeniskelamin_m.jeniskelamin, statusperkawinan_m.statusperkawinan, agama_m.agama, alamat_m.alamatlengkap, pasien_m.notelepon, 
                         pekerjaan_m.pekerjaan, CASE WHEN kesatuanpasien_m.kesatuanpasien IS NULL THEN '-' ELSE kesatuanpasien_m.kesatuanpasien end as kesatuanpasien, CASE WHEN pangkat_m.namapangkat IS NULL THEN '-' ELSE pangkat_m.namapangkat end as namapangkatpolisi, pasien_m.nrp, pasien_m.nip, kecamatan_m.namakecamatan, kotakabupaten_m.namakotakabupaten, 
                         pendidikan_m.pendidikan, kelompokpasien_m.kelompokpasien, rekanan_m.namaexternal        
FROM            pasiendaftar_t AS pd LEFT OUTER JOIN
                         pasien_m ON pd.nocmfk = pasien_m.id LEFT OUTER JOIN
                         jeniskelamin_m ON pasien_m.objectjeniskelaminfk = jeniskelamin_m.id LEFT OUTER JOIN
                         statusperkawinan_m ON pasien_m.objectstatusperkawinanfk = statusperkawinan_m.id LEFT OUTER JOIN
                         agama_m ON pasien_m.objectagamafk = agama_m.id LEFT OUTER JOIN
                         alamat_m ON pasien_m.id = alamat_m.nocmfk LEFT OUTER JOIN
                         pekerjaan_m ON pasien_m.objectpekerjaanfk = pekerjaan_m.id LEFT OUTER JOIN
                         kesatuanpasien_m ON pasien_m.objectkesatuanfk = kesatuanpasien_m.id LEFT OUTER JOIN
                         pangkat_m ON pasien_m.pangkatpolisi = pangkat_m.id LEFT OUTER JOIN
                         desakelurahan_m ON alamat_m.objectdesakelurahanfk = desakelurahan_m.id LEFT OUTER JOIN
                         kecamatan_m ON desakelurahan_m.objectkecamatanfk = kecamatan_m.id LEFT OUTER JOIN
                         kotakabupaten_m ON kecamatan_m.objectkotakabupatenfk = kotakabupaten_m.id LEFT OUTER JOIN
                         pendidikan_m ON pasien_m.objectpendidikanfk = pendidikan_m.id LEFT OUTER JOIN
                         kelompokpasien_m ON pd.objectkelompokpasienlastfk = kelompokpasien_m.id LEFT OUTER JOIN
                         rekanan_m ON pd.objectrekananfk = rekanan_m.id
WHERE        (pd.norec = $P{norec})]]>
	</queryString>
