	<queryString>
		<![CDATA[select    case when ppok.jumlah is null then v_cetaketiket.jumlah else  ppok.jumlah+v_cetaketiket.jumlah end as jumlahtotal,  v_cetaketiket.*  from v_cetaketiket  
left join pelayananpasienobatkronis_t as ppok on v_cetaketiket.strukresepfk = ppok.strukresepfk 
and v_cetaketiket.produkfk = ppok.produkfk
  where v_cetaketiket.norec in ($P!{norec}) and tt=1  
  order by v_cetaketiket.namaproduk]]>
	</queryString>
