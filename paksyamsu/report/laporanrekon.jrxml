<!-- Created with Jaspersoft Studio version 6.17.0.final using JasperReports Library version 6.17.0-6d93193241dd8cc42629e188b94f9e0bc5722efd  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="laporanrekon" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="0ed2131b-c59b-4291-9af1-d2212b7edc5c">
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="0"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="1000"/>
	<property name="ireport.zoom" value="1.6105100000000008"/>
	<property name="ireport.x" value="634"/>
	<property name="ireport.y" value="318"/>
	<parameter name="tglawal" class="java.lang.String"/>
	<parameter name="tglakhir" class="java.lang.String"/>
	<parameter name="namaRS" class="java.lang.String"/>
	<parameter name="gambarLogo" class="java.awt.Image"/>
	<parameter name="alamatRS" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT        sP.tglstruk, sP.nostruk, sP.nofaktur, sP.tglfaktur, pr.id AS kdproduk, pr.kdproduk AS kdsirs, pr.namaproduk, ss.satuanstandar, rkn.namarekanan, pg.namalengkap AS namapenerima, ru.namaruangan,
                         spd.hargasatuan + CASE WHEN spd.hargappn <> 0 THEN (spd.qtyproduk * spd.hargasatuan - spd.qtyproduk * spd.hargadiscount) * 0.1 / spd.qtyproduk ELSE spd.hargappn END - spd.hargadiscount AS hargasatuan, sbk.nosbk,
                         spd.qtyproduk, spd.qtyprodukretur, sP.nosppb, asp.asalproduk, spd.hargadiscount, djs.detailjenisproduk, CASE WHEN spd.hargappn <> 0 THEN (spd.qtyproduk * spd.hargasatuan - spd.qtyproduk * spd.hargadiscount)
                         + (spd.qtyproduk * spd.hargasatuan - spd.qtyproduk * spd.hargadiscount) * 0.1 ELSE (spd.qtyproduk * spd.hargasatuan - spd.qtyproduk * spd.hargadiscount) END AS total,
                         CASE WHEN spd.hargappn <> 0 THEN (spd.qtyproduk * spd.hargasatuan - spd.qtyproduk * spd.hargadiscount) * 0.1 ELSE spd.hargappn END AS hargappn, spd.tglkadaluarsa
FROM            strukpelayanan_t AS sP INNER JOIN
                         strukpelayanandetail_t AS spd ON spd.nostrukfk = sP.norec LEFT OUTER JOIN
                         rekanan_m AS rkn ON rkn.id = sP.objectrekananfk LEFT OUTER JOIN
                         pegawai_m AS pg ON pg.id = sP.objectpegawaipenerimafk LEFT OUTER JOIN
                         ruangan_m AS ru ON ru.id = sP.objectruanganfk LEFT OUTER JOIN
                         produk_m AS pr ON pr.id = spd.objectprodukfk LEFT OUTER JOIN
                         satuanstandar_m AS ss ON ss.id = spd.objectsatuanstandarfk LEFT OUTER JOIN
                         asalproduk_m AS asp ON asp.id = spd.objectasalprodukfk LEFT OUTER JOIN
                         strukbuktipengeluaran_t AS sbk ON sbk.norec = sP.nosbklastfk LEFT OUTER JOIN
                         detailjenisproduk_m AS djs ON djs.id = pr.objectdetailjenisprodukfk
WHERE        (sP.tglstruk between $P{tglawal} and $P{tglakhir}) AND (sP.statusenabled = true) AND (sP.objectkelompoktransaksifk = 35) 
ORDER BY sP.objectrekananfk]]>
	</queryString>
