	<queryString>
		<![CDATA[SELECT       totalharga, noregistrasi, nocm, umur, namapasienjk, penjamin, noteleponfaks, alamat, tgllahir, tglregistrasi, ruanganpasien as ruangan,  noresep, namaruangan as depo , tgl, rke, kdproduk, namaprodukstandar, jumlah, jasa, hargasatuan,
                         qtyhrg, Expr1, jeniskemasan, namalengkap, totaldiscound, totalbiaya, qtydetailresep,dokter,namarekanan,aturanpakai
FROM            V_CetakRincianResepAllnew where norec=$P{norec}
 ORDER BY rke]]>
