	<parameter name="qr" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    ep.namaruangan,
    ps.namapasien,
    ps.nocm,
    TO_CHAR(ps.tgllahir, 'DD-MM-YYYY') as tgllahir,
    jk.jeniskelamin,
    ps.noidentitas,
    ep.kelompokpasien,
    ps.notelepon,
    ps.tempatlahir,
    TO_CHAR(rm.tglpelayanan, 'DD-MM-YYYY') as tglpelayanan,
    rm.kondisiwaktukeluar,
    rm.pasienkeluarga,
    pg.namalengkap,
    jk.jeniskelamin,
    TO_CHAR(CURRENT_DATE, 'DD-MM-YYYY') as tglnow,
    rm.tekanandarah,
    rm.namadokter,
    TO_CHAR(rm.tglmasuk, 'DD-MM-YYYY HH:mm') as tglmasuk,
    rm.rencanatindaklanjut,
    TO_CHAR(rm.tglkontrol, 'DD-MM-YYYY') as tglkontrol,
    rm.kontrol,
    rm.keadaandarurat2,
    rm.sarantransportasi,
    rm.kondisimeninggalkan,
    rm.keluhanutama,
    rm.alergi,
    CASE WHEN rm.tglkontrol IS NOT NULL THEN TO_CHAR(rm.tglkontrol, 'DD-MM-YYYY') ELSE '' END as tglkontrol,
    rm.kesadaran,
    rm.keadaanumum,
    rm.denyutjantung,
    rm.pernapasan,
    rm.systole,
    rm.diastole,
    rm.suhu,
    rm.diet,
    rm.edukasi,
	rm.tglkeluar,
    rm.prognosis,
	rm.diagdok,
    rm.keterangandiet,
	rm.pengobatan,
    rm.pemeriksaandisik
FROM 
    emrpasien_t as ep 
    LEFT JOIN resumemedis_t as rm ON rm.emrpasienfk = ep.noemr 
    LEFT JOIN pegawai_m as pg ON pg.id = rm.pegawaifk 
    LEFT JOIN pasien_m as ps ON ps.nocm = ep.nocm 
    INNER JOIN jeniskelamin_m as jk ON jk.id = ps.objectjeniskelaminfk
WHERE 
    rm.norec = $P{norec} AND rm.statusenabled = true]]>
	</queryString>
