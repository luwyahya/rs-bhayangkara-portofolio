	<parameter name="tahun" class="java.lang.String"/>
	<parameter name="hasillab1" class="java.lang.String"/>
	<queryString>
		<![CDATA[select ag.agama,
case when ps.nip is not null and ps.nip != '-' then ps.nip when ps.nrp is not null and ps.nrp != '-' then ps.nrp when ps.nrpnip is not null and ps.nrpnip != '-' then ps.nrpnip else '-' end as nrpnip,
case when hpm.stakes1 is not null then hpm.stakes1 else '-' end as stakes1,
case when ps.objectsatuankerjafk is not null then sk.satuankerjapasien else '-' end as satuankerja,
case when hpm.stakes2 = 50 then 'K2' + ' ( ' + hpm.stakes2 + ' )'
when hpm.stakes2 between 51 and 57 then 'K1' + ' ( ' + hpm.stakes2 + ' )'
when hpm.stakes2 between 58 and 67 then 'C' + ' ( ' + hpm.stakes2 + ' )'
when hpm.stakes2 between 68 and 80 then 'B' + ' ( ' + hpm.stakes2 + ' )'  else '-' end as stakes2,
hpm.nomor2,
hpm.tinggibadan,
case when hpm.komposisitubuh is not null then hpm.komposisitubuh else '-' end as komposisitubuh,
hpm.tensisist,
hpm.tensidias,
case when hpm.gigi is not null then hpm.gigi else '-' end as gigi,
hpm.beratbadan,
case when hpm.lingkarperut is not null then hpm.lingkarperut else '-' end as lingkarperut,
hpm.nadi,
case when hpm.mata is not null then hpm.mata else '-' end as mata,
hpm.laboratorium,
hpm.ekg,
hpm.treadmill,
hpm.rontgent,
hpm.kesimpulan,
hpm.saran,
hpm.stakes1,
jb.namajabatan,
case when pg.namalengkap is not null then pg.namalengkap else '-' end as timdoktermcu,
case when pg2.namalengkap is not null then pg2.namalengkap else '-' end as timpelaksanamcu,
pg3.namalengkap as dokter,
case when pg3.nrp != ' ' and pg3.nrp is not null and pg3.nrp != '-' then 'NRP ' + pg3.nrp when pg3.nip is not null then 'NIP ' + pg3.nip when pg3.nip_pns is not null then 'NIP ' + pg3.nip_pns when pg3.nippns is not null then 'NIP ' + pg3.nippns else ' ' end as nrpdokter,
case when pg3.objectgolonganfk is not null then glg.namaexternal when ps.pangkatpns is not null then p.namapangkat when ps.pangkatpolisi is not null then p2.namapangkat else ' ' end as pangkatdokter,
case when ps.pangkatpns is not null then p.namapangkat when ps.pangkatpolisi is not null then p2.namapangkat else '-' end as pangkat,
case when pg3.objectgolonganfk is not null and pg3.nrp != ' ' and pg3.nrp is not null and pg3.nrp != '-' then pg3.namalengkap + CHAR(13) + glg.namaexternal + ' ' + 'NRP ' + pg3.nrp 
--when ps.pangkatpns is not null and pg3.nrp != ' ' and pg3.nrp is not null and pg3.nrp != '-' then pg3.namalengkap + CHAR(13) + CHAR(13) + CHAR(13) + CHAR(13) + p.namapangkat  + ' ' + 'NRP ' + pg3.nrp 
when pg3.objectpangkatpolisifk is not null and pg3.nrp != ' ' and pg3.nrp is not null and pg3.nrp != '-' then pg3.namalengkap + CHAR(13) + pp.namaexternal + ' ' + 'NRP ' + pg3.nrp
when pg3.objectgolonganfk is not null and pg3.nippns is not null then pg3.namalengkap + CHAR(13) + glg.namaexternal + ' ' + 'NIP ' + pg3.nippns else ' ' end as namapangkatdokter,
case when pg3.objectgolonganfk is not null and pg3.nrp != ' ' and pg3.nrp is not null and pg3.nrp != '-' then glg.namaexternal + ' ' + 'NRP ' + pg3.nrp 
--when ps.pangkatpns is not null and pg3.nrp != ' ' and pg3.nrp is not null and pg3.nrp != '-' then pg3.namalengkap + CHAR(13) + CHAR(13) + CHAR(13) + CHAR(13) + p.namapangkat  + ' ' + 'NRP ' + pg3.nrp 
when pg3.objectpangkatpolisifk is not null and pg3.nrp != ' ' and pg3.nrp is not null and pg3.nrp != '-' then pp.namaexternal + ' ' + 'NRP ' + pg3.nrp
when pg3.objectgolonganfk is not null and pg3.nippns is not null then glg.namaexternal + ' ' + 'NIP ' + pg3.nippns else ' ' end as pangkatnomordokter
from hasilpemeriksaanmcu_t as hpm left join
pasiendaftar_t as pd on pd.norec = hpm.noregistrasifk left join
pasien_m as ps on ps.id = pd.nocmfk left join
agama_m as ag on ag.id = ps.objectagamafk left join
satuankerjapasien_m as sk on sk.id = ps.objectsatuankerjafk left join
pangkat_m as p on p.id = ps.pangkatpns left join
pangkat_m as p2 on p2.id = ps.pangkatpolisi left join
pegawai_m as pg on pg.id = hpm.pegawaifk left join
pegawai_m as pg2 on pg2.id = hpm.pegawai2fk left join
pegawai_m as pg3 on pg3.id = hpm.pegawai3fk left join
pangkatpolisi_m as pp on pp.id = pg3.objectpangkatpolisifk left join
jabatan_m as jb on jb.id = hpm.jabatanfk left join
sdm_golongan_m as glg on glg.id = pg3.objectgolonganfk
where hpm.norec = $P{norechpm}
and hpm.keterangan = 'Surat Keterangan Medis']]>
	</queryString>
