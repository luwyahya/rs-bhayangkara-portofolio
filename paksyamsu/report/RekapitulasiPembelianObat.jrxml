	<parameter name="tglAkhir" class="java.lang.String"/>
	<parameter name="detailjenisproduk" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT         ROW_NUMBER() over(order by namaproduk) as no,SUM(total) AS total, SUM(jmlTerkecil) AS qtyproduk, satuanstandarSS, hargasatuan, namaproduk,kdproduk, HNA
FROM            V_LaporanPenerimaanSupplier
where  tglstruk between  $P{tglAwal} and  $P{tglAkhir} and detailjenisproduk like '%$P!{detailjenisproduk}%'
GROUP BY satuanstandarSS, hargasatuan, namaproduk, kdproduk, HNA]]>
	</queryString>
