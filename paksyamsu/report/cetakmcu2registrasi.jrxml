<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cetakmcu" pageWidth="612" pageHeight="900" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="89131217-ecd3-43d7-a41f-48762e78fcc0">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="0"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="1000"/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="288"/>
	<parameter name="norec" class="java.lang.String"/>
	<parameter name="gambarLogo" class="java.awt.Image"/>
	<queryString>
		<![CDATA[SELECT pd.noregistrasi,ps.nocm,ddp.keterangan,case when ps.notelepon is null then ' - ' else UPPER(ps.notelepon) end as notelepon, ps.noidentitas,case when ps.namasuamiistri is null then ' - ' else UPPER(ps.namasuamiistri) end as namasuamiistri,case when ps.namaibu is null then ' - ' else UPPER(ps.namaibu) end as namaibu, ps.objectpekerjaanfk, ps.objectsukufk,case when sk.suku is null then ' - ' else UPPER(sk.suku) end as suku,pk.pekerjaan, ps.tempatlahir,ps.nohp,rek.namarekanan,kes.kesatuanpasien,case when ps.nrp is null then ' - ' else ps.nrp end as nrp,UPPER (ps.namapasien) AS namapasien,UPPER(CASE WHEN ps.namakeluarga IS NULL THEN '-' ELSE ps.namakeluarga END) AS namakeluarga,
					  ps.tgllahir,UPPER(jk.jeniskelamin) as jeniskelamin,case when ag.agama is null then ' - ' else UPPER(ag.agama) end as agama,UPPER(pend.pendidikan) as pendidikan,
                      UPPER(sp.statusperkawinan) as statusperkawinan,UPPER(pk.pekerjaan) as pekerjaan,case when ps.penanggungjawab is null then ' - ' else UPPER(ps.penanggungjawab) end  as penanggungjawab,ps.teleponpenanggungjawab,UPPER(ps.alamatrmh) as alamatrmh,UPPER(ps.hubungankeluargapj) as  hubungankeluargapj,
					  pd.tglregistrasi,CONVERT(VARCHAR,pd.tglregistrasi, 8) AS jamregistrasi,UPPER(kp.kelompokpasien) as kelompokpasien,
                      CASE WHEN pg.namalengkap IS NULL THEN '-' ELSE pg.namalengkap end as dpjp, UPPER(kls.namakelas) as kelas,UPPER(ru.namaruangan) as ruangan,
                      CASE WHEN dg.namadiagnosa IS NULL THEN '' ELSE dg.namadiagnosa END AS namadiagnosa,CONVERT(VARCHAR,apd.tglmasuk,105) AS tglmasuk,CONVERT(VARCHAR,apd.tglmasuk,8) AS jammasuk,
                      UPPER(al.alamatlengkap) as alamatlengkap,UPPER(ru.namaruangan) + ' - ' + case when pd.objectkelompokpasienlastfk=2 then kls1.namakelas else UPPER(kls.namakelas) end as bangsal,CASE WHEN dg.kddiagnosa IS NULL THEN '' ELSE dg.kddiagnosa END AS kddiagnosa,
                      case when ru1.objectdepartemenfk in (18,34,45,30,26) THEN 'Rawat Jalan' when ru1.objectdepartemenfk in (24) then 'Gawat Darurat' else '-' end as asalruangan,
											kls1.namakelas
                      FROM pasiendaftar_t as pd
                      INNER JOIN antrianpasiendiperiksa_t as apd ON pd.norec = apd.noregistrasifk
                      INNER JOIN pasien_m as ps ON pd.nocmfk = ps.id
                      LEFT JOIN jeniskelamin_m as jk ON jk.id = ps.objectjeniskelaminfk
                      LEFT JOIN alamat_m as al ON ps.id = al.nocmfk
                      LEFT JOIN agama_m as ag on ag.id = ps.objectagamafk
                      LEFT JOIN pendidikan_m as pend on pend.id = ps.objectpendidikanfk
                      LEFT JOIN statusperkawinan_m as sp on sp.id = ps.objectstatusperkawinanfk
                      LEFT JOIN pekerjaan_m as pk on pk.id = ps.objectpekerjaanfk
                      LEFT JOIN kelompokpasien_m as kp on kp.id = pd.objectkelompokpasienlastfk
                      LEFT JOIN kelas_m as kls on kls.id = pd.objectkelasfk
					  LEFT JOIN suku_m as sk on sk.id = ps.objectsukufk
					   LEFT JOIN ruangan_m as ru on ru.id = apd.objectruanganfk
                      LEFT JOIN detaildiagnosapasien_t AS ddp ON ddp.noregistrasifk = apd.norec
                      LEFT JOIN diagnosa_m AS dg ON dg.id = ddp.objectdiagnosafk
                      LEFT JOIN jenisdiagnosa_m AS jd ON jd.id = ddp.objectjenisdiagnosafk
                      LEFT JOIN pegawai_m as pg on pg.id = apd.objectpegawaifk LEFT JOIN ruangan_m AS ru1 ON ru1.id = pd.objectruanganasalfk
                      LEFT JOIN rekanan_m AS rek ON rek.id = pd.objectrekananfk LEFT JOIN kesatuanpasien_m AS kes ON kes.id = ps.objectkesatuanfk
											LEFT JOIN pemakaianasuransi_t as pa on pa.noregistrasifk = pd.norec
											LEFT JOIN asuransipasien_m as asu on asu.id = pa.objectasuransipasienfk
											LEFT JOIN kelas_m as kls1 on kls1.id = asu.objectkelasdijaminfk  WHERE ru.namaruangan='RIKES (MEDICAL CHECK UP)' and pd.norec=$P{norec}]]>
	</queryString>
