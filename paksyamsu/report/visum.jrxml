	<parameter name="dataLoad" class="java.util.List"/>
	<queryString>
		<![CDATA[SELECT top 10 emrp.nocm,emrdp.emrpasienfk ,emrdp.[value] ,emrdp.emrdfk,
                 emrd.caption,emrd.type, emrd.nourut,emrd.id,emrd.reportdisplay,  emrd.kodeexternal AS kodeex,
                 emrd.satuan,emr.caption as namaform
                 From emrpasiend_t As emrdp
                 INNER JOIN emrpasien_t AS emrp ON emrp.noemr = emrdp.emrpasienfk
                 INNER JOIN emrdpolri_t AS emrd ON emrd.id = emrdp.emrdfk
                 INNER JOIN emr_t AS emr ON emr.id = emrdp.emrfk
                 Where emrdp.statusenabled = 1
                 AND emrp.nocm = $P{nocm}
 								 and emrp.noemr= $P{nomorEMR}
                 AND emr.id in (670) Order by emrdp.emrdfk ASC]]>
	</queryString>
