	<parameter name="idkelompokjabatan" class="java.lang.String"/>
	<parameter name="idkedudukan" class="java.lang.String"/>
	<queryString>
		<![CDATA[select ROW_NUMBER() OVER (ORDER BY pg.id) as nomor,
 pg.namalengkap,
case when pg.objectkelompokjabatanfk is null then '-' else kp.detailkelompokjabatan end as detailkelompokjabatan,
case when pg.tglmasuk is not null then to_char(pg.tglmasuk, 'YYYY-mm-dd')  else '-' end as tglmasuk,
pg.salary 
 from pegawai_m as pg left join
ruangan_m as ru on ru.id = pg.objectruangankerjafk left join
nilaikelompokjabatan_m as kp on kp.id = pg.objectkelompokjabatanfk
where pg.namalengkap not in ('-', '- (Dokter Belum Diinput)', 'Administrator', '- (Petugas Pelaksana Belum Diinput)')
and pg.statusenabled = true
and pg.kedudukanfk = 1]]>
	</queryString>
