	<parameter name="norecrm" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    COALESCE(ep.namaruangan, '-') as namaruangan,
    COALESCE(rm.namapasien, '-') as namapasien,
    COALESCE(rm.nocm, '-') as nocm,
    COALESCE(CAST(rm.tgllahir AS VARCHAR), '-') as tgllahir,
    COALESCE(rm.beratbadan, '-') as beratbadan,
    COALESCE(CAST(rm.tglpelayanan AS VARCHAR), '-') as tglpelayanan,
    COALESCE(rm.kondisiwaktukeluar, '-') as kondisiwaktukeluar,
    COALESCE(rm.pasienkeluarga, '-') as pasienkeluarga,
    COALESCE(pg.namalengkap, '-') as namalengkap,
    COALESCE(jk.jeniskelamin, '-') as jeniskelamin,
    COALESCE(CAST(CURRENT_DATE AS VARCHAR), '-') as tglnow,
    COALESCE(rm.tekanandarah, '-') as tekanandarah
FROM 
    emrpasien_t as ep 
LEFT JOIN
    resumemedis_t as rm ON rm.emrpasienfk = ep.noemr 
LEFT JOIN
    pegawai_m as pg ON pg.id = rm.pegawaifk 
LEFT JOIN
    jeniskelamin_m as jk ON jk.id = rm.objectjeniskelaminfk
WHERE 
    ep.norec_apd = $P{norec_apd} AND rm.statusenabled = true AND rm.norec = $P{norecrm}]]>
	</queryString>
