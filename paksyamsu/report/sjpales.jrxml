	<parameter name="namaRS" class="java.lang.String"/>
	<parameter name="tgllahir" class="java.util.Date"/>
	<parameter name="gambarLogo" class="java.awt.Image"/>
	<parameter name="alamatRS" class="java.lang.String"/>
	<parameter name="noregistrasi" class="java.lang.String"/>
	<parameter name="pegawai" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT
	date_part( 'year', age( pasien_m.tgllahir ) ) || ' Tahun ' || date_part( 'month', age( pasien_m.tgllahir ) ) || ' Bulan ' || date_part( 'day', age( pasien_m.tgllahir ) ) || ' Hari ' AS umur,alamat_m.alamatlengkap ,pasien_m.nohp, pasien_m.namapasien,antrianpasiendiperiksa_t.noantrian,pasien_m.namaibu,ruangan_m.namaruangan,pasiendaftar_t.tglregistrasi,pegawai_m.namalengkap,to_char(pasiendaftar_t.tglregistrasi, 'DD/Mon/YYYY')  as ayeuna,pasien_m.nocm 
,jeniskelamin_m.jeniskelamin, ruangan_m.namaruangan || '-' || antrianpasiendiperiksa_t.namahafis || '-' || antrianpasiendiperiksa_t.noantrian as antrian, nokepesertaan || '/' || nosep as kartu,rk.namaexternal as namarekanan FROM
	pasien_m
	INNER JOIN alamat_m ON pasien_m.ID = alamat_m.nocmfk 
	INNER JOIN pasiendaftar_t on pasien_m.id = pasiendaftar_t.nocmfk
	inner join antrianpasiendiperiksa_t on pasiendaftar_t.norec = antrianpasiendiperiksa_t.noregistrasifk
	inner join ruangan_m on antrianpasiendiperiksa_t.objectruanganfk = ruangan_m.id
	left join pegawai_m on pasiendaftar_t.objectpegawaifk = pegawai_m.id
	inner join jeniskelamin_m on pasien_m.objectjeniskelaminfk = jeniskelamin_m.id
	left join pemakaianasuransi_t on pasiendaftar_t.norec = pemakaianasuransi_t.noregistrasifk
	left join rekanan_m as rk on rk.id=pasiendaftar_t.objectrekananfk
	where   pasiendaftar_t.noregistrasi= $P{noregistrasi}
		order by antrianpasiendiperiksa_t.tglmasuk ASC
	limit 1]]>
	</queryString>
	<field name="umur" class="java.lang.String"/>
	<field name="alamatlengkap" class="java.lang.String"/>
	<field name="nohp" class="java.lang.String"/>
	<field name="namapasien" class="java.lang.String"/>
	<field name="noantrian" class="java.lang.String"/>
	<field name="namaibu" class="java.lang.String"/>
	<field name="namaruangan" class="java.lang.String"/>
