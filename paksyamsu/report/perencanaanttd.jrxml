	<queryString>
		<![CDATA[SELECT      top 1  orderpelayanan_t.hargasatuan/hasilkonversi as harga, orderpelayanan_t.hasilkonversi* orderpelayanan_t.qtyproduk as qty, (orderpelayanan_t.hargasatuan/hasilkonversi)*(orderpelayanan_t.hasilkonversi* orderpelayanan_t.qtyproduk) as total,rekanan_m.namarekanan, produk_m.namaproduk, satuanstandar_m.satuanstandar
FROM            satuanstandar_m INNER JOIN
                         produk_m ON satuanstandar_m.id = produk_m.objectsatuanstandarfk INNER JOIN
                         orderpelayanan_t ON produk_m.id = orderpelayanan_t.objectprodukfk INNER JOIN
                         rekanan_m ON orderpelayanan_t.objectrekananfk = rekanan_m.id
 where orderpelayanan_t.tglpelayanan between $P{tglawal} and $P{tglakhir}                        
ORDER BY rekanan_m.namarekanan]]>
	</queryString>
