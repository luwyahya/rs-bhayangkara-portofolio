	<parameter name="kelompok" class="java.lang.String"/>
	<parameter name="alokasi" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select *,round((bulanlalu/dipa)*100,2) as persenbulanlalu,round((bulanini/dipa)*100,2) as persenbulanini,bulanlalu+bulanini as sdbulanini,round((bulanlalu/dipa)*100,2)+round((bulanini/dipa)*100,2) as persensdini,dipa-bulanlalu-bulanini as sisadana,100-(round((bulanlalu/dipa)*100,2)+round((bulanini/dipa)*100,2)) as persensisa 
				  from v_realisasi
				  where tahun=$P{tahun}
			and kd2 like '%$P!{kelompok}%' 
				  order by kd2]]>
	</queryString>
