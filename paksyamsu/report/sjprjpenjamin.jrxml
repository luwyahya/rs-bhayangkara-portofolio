<!-- Created with Jaspersoft Studio version 6.16.0.final using JasperReports Library version 6.5.1  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="sjprjpenjamin" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" isIgnorePagination="true" uuid="dc16ac77-ba85-4c05-87fe-8ab269570601">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="0"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="1000"/>
	<parameter name="namaRS" class="java.lang.String"/>
	<parameter name="gambarLogo" class="java.awt.Image"/>
	<parameter name="alamatRS" class="java.lang.String"/>
	<parameter name="noregistrasi" class="java.lang.String"/>
	<parameter name="pegawai" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
	date_part( 'year', age( pasien_m.tgllahir ) ) || ' Tahun ' || date_part( 'month', age( pasien_m.tgllahir ) ) || ' Bulan ' || date_part( 'day', age( pasien_m.tgllahir ) ) || ' Hari ' AS umur,alamat_m.alamatlengkap ,pasien_m.nohp, pasien_m.namapasien,antrianpasiendiperiksa_t.noantrian,pasien_m.namaibu,ruangan_m.namaruangan,antrianpasiendiperiksa_t.tglregistrasi,pegawai_m.namalengkap,to_char(antrianpasiendiperiksa_t.tglregistrasi, 'DD/Mon/YYYY')  as ayeuna,pasien_m.nocm 
,jeniskelamin_m.jeniskelamin, ruangan_m.namaruangan || '-' || antrianpasiendiperiksa_t.namahafis || '-' || antrianpasiendiperiksa_t.noantrian as antrian, nokepesertaan || '/' || nosep as kartu,rk.namaexternal as namarekanan,pasiendaftar_t.catatan FROM
	pasien_m
	INNER JOIN alamat_m ON pasien_m.ID = alamat_m.nocmfk 
	INNER JOIN pasiendaftar_t on pasien_m.id = pasiendaftar_t.nocmfk
	inner join antrianpasiendiperiksa_t on pasiendaftar_t.norec = antrianpasiendiperiksa_t.noregistrasifk
	inner join ruangan_m on antrianpasiendiperiksa_t.objectruanganfk = ruangan_m.id
	left join pegawai_m on antrianpasiendiperiksa_t.objectpegawaifk = pegawai_m.id
	inner join jeniskelamin_m on pasien_m.objectjeniskelaminfk = jeniskelamin_m.id
	left join pemakaianasuransi_t on pasiendaftar_t.norec = pemakaianasuransi_t.noregistrasifk
	left join rekanan_m as rk on rk.id=pasiendaftar_t.objectrekananfk
	where  ruangan_m.objectdepartemenfk not in (3,16) and   pasiendaftar_t.noregistrasi= $P{noregistrasi}
	order by antrianpasiendiperiksa_t.tglmasuk ASC
	limit 1]]>
	</queryString>
