	<queryString>
		<![CDATA[SELECT       V_CetakRincianResepAll.totalharga, V_CetakRincianResepAll.noregistrasi, V_CetakRincianResepAll.nocm, V_CetakRincianResepAll.umur, V_CetakRincianResepAll.namapasienjk, V_CetakRincianResepAll.penjamin, 
                         V_CetakRincianResepAll.noteleponfaks, V_CetakRincianResepAll.alamat, V_CetakRincianResepAll.tgllahir, V_CetakRincianResepAll.tglregistrasi, V_CetakRincianResepAll.ruanganpasien, 
                         V_CetakRincianResepAll.noresep, V_CetakRincianResepAll.namaruangan, V_CetakRincianResepAll.tgl, V_CetakRincianResepAll.rke, V_CetakRincianResepAll.kdproduk, V_CetakRincianResepAll.namaprodukstandar, 
                         V_CetakRincianResepAll.jumlah, V_CetakRincianResepAll.jasa, V_CetakRincianResepAll.hargasatuan, V_CetakRincianResepAll.qtyhrg, V_CetakRincianResepAll.Expr1, V_CetakRincianResepAll.jeniskemasan, 
                         V_CetakRincianResepAll.namalengkap, V_CetakRincianResepAll.totaldiscound, V_CetakRincianResepAll.totalbiaya, V_CetakRincianResepAll.qtydetailresep, V_CetakRincianResepAll.norec, V_CetakRincianResepAll.dokter, 
                         V_CetakRincianResepAll.namarekanan, pelayananpasien_t.keteranganpakai, case when pelayananpasien_t.issore = '1' then 'Sore' else'' end as sore, case when pelayananpasien_t.ismalam ='1' then 'Malam' else'' end as malam, case when pelayananpasien_t.issiang='1' then 'Siang' else'' end as siang, 
						 case when pelayananpasien_t.ispagi ='1' then 'Pagi' else'' end as pagi, 
                         pelayananpasien_t.aturanpakai
FROM            V_CetakRincianResepAll INNER JOIN
                         pelayananpasien_t ON V_CetakRincianResepAll.norec = pelayananpasien_t.strukresepfk AND V_CetakRincianResepAll.kdproduk = pelayananpasien_t.produkfk

 where V_CetakRincianResepAll.norec=$P{norec}]]>
	</queryString>
