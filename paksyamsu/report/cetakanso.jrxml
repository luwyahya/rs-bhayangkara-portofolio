	<parameter name="namaRS" class="java.lang.String"/>
	<parameter name="gambarLogo" class="java.awt.Image"/>
	<parameter name="alamatRS" class="java.lang.String"/>
	<parameter name="namaruangan" class="java.lang.String"/>
	<parameter name="objectruanganfk" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT        stokprodukdetail_t.objectprodukfk, produk_m.statusenabled, produk_m.namaproduk, ruangan_m.namaruangan,upper(bentukproduk_m.namabentukproduk) as namabentukproduk, SUM(stokprodukdetail_t.qtyproduk) AS stok,
                         satuanstandar_m.satuanstandar
FROM            stokprodukdetail_t INNER JOIN
                         ruangan_m ON stokprodukdetail_t.objectruanganfk = ruangan_m.id INNER JOIN
                         produk_m ON stokprodukdetail_t.objectprodukfk = produk_m.id INNER JOIN
                         bentukproduk_m ON produk_m.objectbentukprodukfk = bentukproduk_m.id INNER JOIN
                         satuanstandar_m ON produk_m.objectsatuanstandarfk = satuanstandar_m.id
WHERE        (stokprodukdetail_t.objectruanganfk = $P{objectruanganfk} ) and produk_m.statusenabled= true and qtyproduk>0
GROUP BY stokprodukdetail_t.objectprodukfk, produk_m.statusenabled, produk_m.namaproduk, ruangan_m.namaruangan, bentukproduk_m.namabentukproduk, satuanstandar_m.satuanstandar
ORDER BY bentukproduk_m.namabentukproduk, produk_m.namaproduk]]>
	</queryString>
