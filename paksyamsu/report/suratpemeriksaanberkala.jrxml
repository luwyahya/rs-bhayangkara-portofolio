	<parameter name="tahun" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select 
ps.nrpnip,
hpm.*,
pg.namalengkap as dokter,
case when ps.pangkatpns is not null then p.namapangkat when ps.pangkatpolisi is not null then p2.namapangkat else '-' end as pangkat
from hasilpemeriksaanmcu_t as hpm left join
pasiendaftar_t as pd on pd.norec = hpm.noregistrasifk left join
pasien_m as ps on ps.id = pd.nocmfk left join
pangkat_m as p on p.id = ps.pangkatpns left join
pangkat_m as p2 on p2.id = ps.pangkatpolisi left join
pegawai_m as pg on pg.id = hpm.pegawaifk 
where hpm.norec = $P{norec}
and hpm.keterangan = 'Surat Hasil Pemeriksaan Berkala']]>
	</queryString>
