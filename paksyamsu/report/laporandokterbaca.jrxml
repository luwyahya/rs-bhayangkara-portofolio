	<parameter name="namaRS" class="java.lang.String"/>
	<parameter name="gambarLogo" class="java.awt.Image"/>
	<parameter name="alamatRS" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
 CAST (hr.tanggalbacaradiologi AS date) as tanggalbacaradiologi , ps.nocm, ps.namapasien, hr.nofoto, kp.kelompokpasien, pg3.namalengkap as dokterbaca

FROM pelayananpasien_t as pp

JOIN antrianpasiendiperiksa_t as apd
ON apd.norec = pp.noregistrasifk
JOIN pasiendaftar_t as pd
ON pd.norec = apd.noregistrasifk
JOIN pasien_m as ps
ON ps.id = pd.nocmfk
LEFT JOIN jeniskelamin_m as jk
ON jk.id = ps.objectjeniskelaminfk
JOIN produk_m as pr
ON pr.id = pp.produkfk
JOIN ruangan_m as ru
ON ru.id = apd.objectruanganfk
JOIN ruangan_m as ru1
ON ru1.id = apd.objectruanganasalfk
JOIN departemen_m as dp
ON dp.id = ru.objectdepartemenfk
LEFT JOIN strukpelayanan_t as sp
ON sp.norec = pp.strukfk
LEFT JOIN kelompokpasien_m as kp
ON kp.id=pd.objectkelompokpasienlastfk
LEFT JOIN strukorder_t as so ON
so.norec = pp.strukorderfk
LEFT JOIN pegawai_m as pg
ON pg.id = pp.objectpegawaipengirimfk
LEFT JOIN pegawai_m as pg2
ON pg2.id = apd.objectpegawaifk
LEFT JOIN ris_order as ris
ON ris.order_no = so.noorder
AND ris.order_code=pp.produkfk
LEFT JOIN hasilradiologi_t AS hr
ON hr.pelayananpasienfk=pp.norec
AND hr.statusenabled= 'y'
 JOIN pegawai_m as pg3
ON pg3.id=hr.pegawaifk
WHERE hr.nofoto IS NOT NULL
AND pp.strukresepfk IS NULL
AND ru.objectdepartemenfk=27
AND hr.tanggalbacaradiologi IS NOT NULL
AND hr.tanggalbacaradiologi >='2022-06-01 00:00'
AND hr.tanggalbacaradiologi <='2022-06-09 23:59'
group by ps.nocm, ps.namapasien, jk.jeniskelamin, pp.tglpelayanan, pp.produkfk, pr.namaproduk, pr.namaexternal,
pp.jumlah, pp.hargasatuan, pp.hargadiscount, sp.nostruk, pd.noregistrasi, ru.namaruangan, ru1.namaruangan,
dp.namadepartemen, ps.id, apd.norec, sp.norec, pp.norec,ps.objectjeniskelaminfk,ps.tgllahir,pg.namalengkap,
ru.objectdepartemenfk, so.noorder, ris.order_key, apd.objectruanganfk,pp.iscito,pp.jasa, hr.norec,hr.nofoto,
pg.id, kp.id, pg3.id, pg2.id,apd.tanggalbacaradiologi]]>
	</queryString>
	<field name="namapasien" class="java.lang.String">
		<property name="property.name" value="value"/>
	</field>
