	<parameter name="pembayaran" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT        sp.nostruk AS noregistrasi, sbp.totaldibayar, ps.namapasien, pg.namalengkap, sbp.keteranganlainnya || ' / ' || ru.namaruangan || ' / ' || rk.namarekanan as keteranganlainnya, sbp.keteranganlainnya AS namaruangan, ps.nocm, sp.tglstruk AS tglregistrasi, sp.tglstruk AS tglpulang, to_char(sbp.tglsbm, 'yyyy-MM-dd') AS tanggal, sbp.nosbm AS nobayar, sbp.iscorona, ru.namaruangan AS ruanganterakhir, CASE WHEN rk.namarekanan IS NULL THEN '-' ELSE rk.namarekanan END AS namarekanan,to_char(sbp.tglsbm,'yyyy-MM-dd hh:mi') as tglsbm,
                         sp.keteranganlainnya AS KeteranganD
FROM            strukpelayanan_t AS sp INNER JOIN
                         strukbuktipenerimaan_t AS sbp ON sbp.nostrukfk = sp.norec LEFT OUTER JOIN
                         loginuser_s AS lu ON lu.id = sbp.objectpegawaipenerimafk LEFT OUTER JOIN
                         pasien_m AS ps ON ps.id = sp.nocmfk LEFT OUTER JOIN
                         pegawai_m AS pg ON pg.id = lu.objectpegawaifk LEFT OUTER JOIN
                         pasiendaftar_t AS pd ON pd.norec = sp.noregistrasifk LEFT OUTER JOIN
                         rekanan_m AS rk ON rk.id = pd.objectrekananfk INNER  JOIN
						 ruangan_m AS ru ON ru.id = pd.objectruanganlastfk 
						 where nosbm = $P{noKwitansi}]]>
	</queryString>
