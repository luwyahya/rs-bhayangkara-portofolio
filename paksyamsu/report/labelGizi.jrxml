	<queryString>
		<![CDATA[SELECT        noregistrasi, nokirim, qtykirim, keteranganlainnyakirim, cc, volume, tglregistrasi, tgllahir, tgllahirNew, namapasien, nocm, ruanganasal, jeniswaktu, jenisdiet,jenisdiet1,jenisdiet2, qtyproduk, namakelas, kategorydiet, tglorder, jammakan, keterangan, 
                         diagnosa, jeniskelamin, norec, umur,keteranganwaktu
FROM            V_LABELGIZI where norec in ($P!{norec}) and (  keteranganwaktu  <> case when namakelas = 'Kelas III' then 'Snack Sore' else '' end )
