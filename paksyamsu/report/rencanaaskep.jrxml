	<subDataset name="kolom1" uuid="1bc53932-a790-4f3a-8c69-70969c83646f">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
		<parameter name="noemr" class="java.lang.String"/>
		<parameter name="emrfk" class="java.lang.String"/>
		<queryString>
			<![CDATA[select distinct * from (
                    SELECT      emraskep_t.kolom,  emrpasiend_t.emrpasienfk, emrpasiend_t.emrdfk, emrpasiend_t.emrfk, emrpasiend_t.tgl, emr_t.namaemr, emr_t.caption, case when type ='combobox' then  emraskep_t.caption + substring(emrpasiend_t.value,3,10) else emraskep_t.caption end AS captionemr, emrpasiend_t.value, emraskep_t.type,emraskep_t.nourut
                    FROM            emrpasiend_t INNER JOIN
                                            emraskep_t ON emrpasiend_t.emrdfk = emraskep_t.id INNER JOIN
                                            emr_t ON emrpasiend_t.emrfk = emr_t.id
                    WHERE        (emrpasiend_t.emrpasienfk = $P{noemr})  and emraskep_t.kolom=1 and  emrpasiend_t.value <>'0' and emraskep_t.emrfk=  $P{emrfk}
                    union all

                    SELECT  distinct   emraskep_t.kolom, '' as emrpasienfk,'' as emrdfk,'' as  emrfk, '' as tgl, emr_t.namaemr, emr_t.caption, emraskep_t.caption AS captionemr, '' as value, emraskep_t.type, emraskep_t.nourut
                    FROM            emrpasiend_t INNER JOIN
                                            emr_t ON emrpasiend_t.emrfk = emr_t.id RIGHT OUTER JOIN
                                            emraskep_t ON emr_t.id = emraskep_t.emrfk
                    WHERE        (emrpasiend_t.emrpasienfk = $P{noemr}) and style is not null and type='label' and emraskep_t.emrfk=  $P{emrfk} and emraskep_t.kolom=1 ) as x
                    order by kolom,nourut]]>
		</queryString>
		<field name="captionemr" class="java.lang.String"/>
	</subDataset>
	<subDataset name="kolom2" uuid="4f97378f-97c1-4590-8f65-17c326c90e34">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
		<parameter name="noemr" class="java.lang.String"/>
		<parameter name="emrfk" class="java.lang.String"/>
		<queryString>
			<![CDATA[select distinct * from (
                    SELECT      emraskep_t.kolom,  emrpasiend_t.emrpasienfk, emrpasiend_t.emrdfk, emrpasiend_t.emrfk, emrpasiend_t.tgl, emr_t.namaemr, emr_t.caption, case when type ='combobox' then  emraskep_t.caption + substring(emrpasiend_t.value,3,10) else emraskep_t.caption end AS captionemr, emrpasiend_t.value, emraskep_t.type,emraskep_t.nourut
                    FROM            emrpasiend_t INNER JOIN
                                            emraskep_t ON emrpasiend_t.emrdfk = emraskep_t.id INNER JOIN
                                            emr_t ON emrpasiend_t.emrfk = emr_t.id
                    WHERE        (emrpasiend_t.emrpasienfk = $P{noemr})  and emraskep_t.kolom=2 and emrpasiend_t.value <>'0' and emraskep_t.emrfk=  $P{emrfk}
                    union all

                    SELECT  distinct   emraskep_t.kolom, '' as emrpasienfk,'' as emrdfk,'' as  emrfk, '' as tgl, emr_t.namaemr, emr_t.caption, emraskep_t.caption AS captionemr, '' as value, emraskep_t.type, emraskep_t.nourut
                    FROM            emrpasiend_t INNER JOIN
                                            emr_t ON emrpasiend_t.emrfk = emr_t.id RIGHT OUTER JOIN
                                            emraskep_t ON emr_t.id = emraskep_t.emrfk
                    WHERE        (emrpasiend_t.emrpasienfk =$P{noemr})   and style is not null and type='label' and emraskep_t.emrfk='527' and emraskep_t.kolom=2  and emraskep_t.emrfk=  $P{emrfk}) as x
                    order by kolom,nourut]]>
		</queryString>
		<field name="captionemr" class="java.lang.String"/>
	</subDataset>
