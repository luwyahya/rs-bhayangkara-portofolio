	<parameter name="namaRS" class="java.lang.String"/>
	<parameter name="alamatRS" class="java.lang.String"/>
	<parameter name="gambarLogo" class="java.awt.Image"/>
	<parameter name="tglAwal" class="java.lang.String"/>
	<parameter name="tglAkhir" class="java.lang.String"/>
	<parameter name="grandTotal" class="java.lang.String"/>
	<parameter name="ruangan" class="java.lang.String"/>
	<parameter name="terbilang" class="java.lang.String"/>
	<parameter name="ruanganAsal" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT   row_number() over (order by  produk_m.namaproduk )  as no,produk_m.id, produk_m.namaproduk, ROUND(dbo.getHarga( kirimproduk_t.objectruanganfk  ,$P{tglAwal}, $P{tglAkhir},produk_m.id),2)  AS harga, SUM(kirimproduk_t.qtyproduk) AS jumlah, ROUND((SUM(kirimproduk_t.qtyproduk) * dbo.getHarga(kirimproduk_t.objectruanganfk  ,$P{tglAwal}, $P{tglAkhir},produk_m.id)),2)  AS total,
                                                satuanstandar_m.satuanstandar, ruangan_m.namaruangan, SUM(kirimproduk_t.qtyorder) as qtyorder,ru1.namaruangan as ruanganpengirim
                                                FROM            kirimproduk_t INNER JOIN
                                                        produk_m ON kirimproduk_t.objectprodukfk = produk_m.id AND kirimproduk_t.objectprodukkirimfk = produk_m.id INNER JOIN
                                                        satuanstandar_m ON kirimproduk_t.objectsatuanstandarfk = satuanstandar_m.id INNER JOIN
                                                        ruangan_m ON kirimproduk_t.objectruanganfk = ruangan_m.id INNER JOIN ruangan_m as ru1 ON kirimproduk_t.objectruanganpengirimfk = ru1.id
                                                    where kirimproduk_t.tglpelayanan between $P{tglAwal} and  $P{tglAkhir} and kirimproduk_t.objectruanganpengirimfk =   $P{ruangan} and  kirimproduk_t.objectruanganfk  =  $P{ruanganAsal}
                                                    GROUP BY produk_m.id, produk_m.namaproduk, kirimproduk_t.harganetto, satuanstandar_m.satuanstandar, ruangan_m.namaruangan,ru1.namaruangan, kirimproduk_t.objectruanganfk
                                                    order by produk_m.namaproduk,ruangan_m.namaruangan,kirimproduk_t.objectruanganfk,produk_m.id]]>
	</queryString>
