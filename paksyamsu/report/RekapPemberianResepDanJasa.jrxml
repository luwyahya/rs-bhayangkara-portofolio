	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
	<parameter name="namaRS" class="java.lang.String"/>
	<parameter name="gambarLogo" class="java.awt.Image"/>
	<parameter name="alamatRS" class="java.lang.String"/>
	<parameter name="tglAwal" class="java.lang.String"/>
	<parameter name="tglAkhir" class="java.lang.String"/>
	<parameter name="objectruanganfk" class="java.lang.String"/>
	<parameter name="instalasi" class="java.lang.String"/>
	<parameter name="penjamin" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT       ROW_NUMBER() over(order by namapasien) as noUrut, nocm, namapasien,  sum(hargasatuan) as hargasatuan ,sum(jumlah) as jumlah, sum(jasa) as jasa, sum(total) as total,namaruangan
FROM            v_LaporanJasaEntriResep where  (tglpelayanan between $P{tglAwal} and $P{tglAkhir}) and (ruanganfk= $P{objectruanganfk}) and(objectdepartemenfk LIKE '%$P!{instalasi}%')
and(objectkelompokpasienlastfk LIKE '%$P!{penjamin}%')
group by  nocm, namapasien,namaruangan]]>
	</queryString>
