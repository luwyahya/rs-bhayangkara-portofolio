	<parameter name="pasienkeluarga" class="java.lang.String"/>
	<parameter name="obatobatakhir" class="java.lang.String"/>
	<parameter name="namaobat" class="java.lang.String"/>
	<parameter name="jumlah" class="java.lang.String"/>
	<parameter name="dosis" class="java.lang.String"/>
	<parameter name="frekuensi" class="java.lang.String"/>
	<parameter name="carapemberian" class="java.lang.String"/>
	<parameter name="signature" class="java.lang.String"/>
	<parameter name="gambarTtd" class="java.awt.Image"/>
	<parameter name="asalrujukan" class="java.lang.String"/>
	<queryString>
		<![CDATA[select DISTINCT prd.namaproduk as namaobat, SUM(pp.jumlah) as jumlah,
case when pp.dosisobat is null then '-' else pp.dosisobat end as dosisobat,
case when pp.frekuensi is null then pp.aturanpakai else pp.frekuensi end as frekuensi,
case when rt.name is null then '-' else rt.name end as carapemberian
from pasiendaftar_t as pd
inner join antrianpasiendiperiksa_t as apd on apd.noregistrasifk=pd.norec
inner join strukresep_t as sr on sr.pasienfk=apd.norec
inner join pelayananpasien_t as pp on pp.strukresepfk=sr.norec
inner join produk_m as prd on prd.id=pp.produkfk
left join routefarmasi as rt on rt.id=pp.routefk
WHERE (pd.noregistrasi=$P{noregistrasi})   AND prd.objectkelompokprodukbpjsfk IN ('13','14','15')
AND pp.isrm is not null
GROUP BY prd.namaproduk, pp.dosisobat, rt.name, pp.aturanpakai, pp.frekuensi]]>
	</queryString>
	<field name="carapemberian" class="java.lang.String">
