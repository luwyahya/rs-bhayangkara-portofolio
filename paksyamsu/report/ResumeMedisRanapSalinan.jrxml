	<parameter name="obataturanpakai" class="java.lang.String"/>
	<parameter name="diagnosis" class="java.lang.String"/>
	<parameter name="obatpulang" class="java.lang.String"/>
	<parameter name="tindakanmedisicd9" class="java.lang.String"/>
	<parameter name="penunjanglab" class="java.lang.String"/>
	<parameter name="penunjangpa" class="java.lang.String"/>
	<parameter name="penunjangrad" class="java.lang.String"/>
	<parameter name="qrdok" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    ep.namaruangan,
    ps.namapasien,
    ps.nocm,
    TO_CHAR(ps.tgllahir, 'DD-MM-YYYY') AS tgllahir,
    jk.jeniskelamin,
    ps.noidentitas,
    ep.kelompokpasien,
    ps.notelepon,
    ps.tempatlahir,
    rm.kondisiwaktukeluar,
    rm.pasienkeluarga,
    pg.namalengkap,
    rm.tekanandarah,
    rm.namadokter,
    TO_CHAR(rm.tglmasuk, 'DD-MM-YYYY HH:mm') AS tglmasuk,
    rm.rencanatindaklanjut,
    rm.kontrol,
    rm.keadaandarurat2,
    rm.sarantransportasi,
    rm.kondisimeninggalkan,
    rm.keluhanutama,
    rm.alergi,
    CASE WHEN rm.tglkontrol IS NOT NULL THEN TO_CHAR(rm.tglkontrol, 'DD-MM-YYYY') ELSE '' END AS tglkontrol,
    rm.kesadaran,
    rm.keadaanumum,
    rm.denyutjantung,
    rm.pernapasan,
    rm.systole,
    rm.diastole,
    rm.suhu,
    rm.diet,
    rm.edukasi,
    rm.prognosis,
    rm.pemeriksaanfisik,
    rm.hasilkonsultasi,
    rm.ringkasanriwayatpenyakit,
    rm.kesadaranafter,
    rm.keadaanumumafter,
    rm.denyutjantungafter,
    rm.pernapasanafter,
    rm.systoleafter,
    rm.diastoleafter,
    rm.suhuafter,
    rm.alasanrawat,
    rm.keterangandiet,
    rm.terapipulang,
    rm.tglkeluar,
    rm.tindakanrm,
    rm.terapipengobatanrumahsakit,
    rm.indikasirawatinap,
    rm.pfnadi,
    rm.pfspo,
    rm.pfbb,
    rm.pftb,
    rm.pfe,
    rm.pfm,
    rm.pfv,
    rm.diagdok,
    rm.pfv,
    rm.carapulang,
    rm.tindakanrm,
    rm.ku,
    rm.kesadaranpulang,
    rm.tekanandarah,
    rm.suhupulang,
    rm.pernafasanpulang,
    rm.nadipulang,
	rm.temuanpenting,
	CASE WHEN rm.ismandiriya = true THEN 'Mandiri' WHEN rm.isdibantusetengahya = true THEN 'Dibantu Sebagian' WHEN rm.isdibantupenuhya THEN 'Dibantu Penuh' END AS msp,
	CASE WHEN rm.iswalkerya = true THEN 'Walker' WHEN rm.isalatbantulainlainya = true THEN 'Lain-lain' END AS ab,
	TRIM(
                CASE 
                    WHEN rm.istidakadaalatkesehatanya = true THEN 'Tidak Ada, ' ELSE '' END ||
                    CASE WHEN rm.isivcateterya = true THEN 'IV Cateter, ' ELSE '' END ||
                    CASE WHEN rm.isdobellumenya = true THEN 'Dobel Lumen, ' ELSE '' END ||
                    CASE WHEN rm.isngtya = true THEN 'NGT, ' ELSE '' END ||
					CASE WHEN rm.isoksigenya = true THEN 'Oksigen, ' ELSE '' END ||
					CASE WHEN rm.isalatkesehatanlainlainya = true THEN 'Lain-lain, ' ELSE '' END
        ) AS akyt,
	CASE WHEN rm.istidakadaalatkesehatanya = true THEN 'Tidak Ada' WHEN rm.isivcateterya = true THEN 'IV Cateter' WHEN rm.isdobellumenya = true THEN 'Dobel Lumen' WHEN rm.isngtya = true THEN 'NGT' WHEN rm.isoksigenya = true THEN 'Oksigen' WHEN rm.isalatkesehatanlainlainya = true THEN 'Lain-lain' END AS akyt,
    CASE 
        WHEN rm.israwatdirumahya = true THEN 'Ada' 
        ELSE 'Tidak' 
    END AS perawatandirumah,
    CASE 
        WHEN rm.israwatdirumahya = true THEN 
            TRIM(
                CASE 
                    WHEN rm.ishomecareya = true THEN 'Home Care, ' ELSE '' END ||
                    CASE WHEN rm.isperawatanlanjutanya = true THEN 'Perawatan Lanjutan, ' ELSE '' END ||
                    CASE WHEN rm.ispengobatanlukaya = true THEN 'Perawatan Luka, ' ELSE '' END ||
                    CASE WHEN rm.ispengobatanlanjutanya = true THEN 'Pengobatan Lanjutan, ' ELSE '' END ||
                    CASE WHEN rm.isfaskesterdekatya = true THEN 
                        'Fasilitas Kesehatan Terdekat Dari Rumah' || 
                        CASE WHEN rm.faskesterdekat IS NOT NULL THEN ' - ' || rm.faskesterdekat ELSE '' END || ', ' 
                    ELSE '' END
                )
        ELSE NULL 
    END AS perawatanrumahlist,
		TRIM(
                CASE 
                    WHEN rm.ispenyakitya = true THEN 'Penyakit, ' ELSE '' END ||
                    CASE WHEN rm.isefeksampingobatya = true THEN 'Obat dan Efek Samping Obat, ' ELSE '' END ||
                    CASE WHEN rm.isdietya = true THEN 'Diet, ' ELSE '' END ||
                    CASE WHEN rm.isaktifitasistirahatya = true THEN 'Aktifitas dan Istirahat Dirumah, ' ELSE '' END ||
					CASE WHEN rm.ishygieneya = true THEN 'Hygiene, ' ELSE '' END ||
					CASE WHEN rm.isperawatanlukadirumahya = true THEN 'Perawatan Luka Dirumah, ' ELSE '' END ||
					CASE WHEN rm.isnyeriya = true THEN 'Nyeri, ' ELSE '' END ||
					CASE WHEN rm.isperawatanibubayiya = true THEN 'Perawatan Ibu dan Bayi, ' ELSE '' END ||
                    CASE WHEN rm.ispertolonganmendesakya = true THEN 
                'Pertolongan Mendesak' || 
                CASE WHEN rm.pertolonganmendesak IS NOT NULL THEN ' - ' || rm.pertolonganmendesak ELSE '' END || ', ' 
            ELSE '' END ||
            CASE WHEN rm.iskebutuhanedukasilainlainya = true THEN 
                'Lain-lain' || 
                CASE WHEN rm.kebutuhanedukasilainlain IS NOT NULL THEN ' - ' || rm.kebutuhanedukasilainlain ELSE '' END || ', ' 
            ELSE '' END
        ) AS kebutuhanedukasi,
		TRIM(
                CASE 
                    WHEN rm.islaboratoriumya = true THEN 'Laboratorium, ' ELSE '' END ||
                    CASE WHEN rm.isradiologiya = true THEN 'Radiologi, ' ELSE '' END ||
            CASE WHEN rm.ispemeriksaanpenunjanglainlainya = true THEN 
                'Lain-lain' || 
                CASE WHEN rm.pemeriksaanpenunjanglainlain IS NOT NULL THEN ' - ' || rm.pemeriksaanpenunjanglainlain ELSE '' END || ', ' 
            ELSE '' END
        ) AS ppp,
    CASE WHEN rm.iskontroltidak = '1' THEN 'Kontrol Ke Poli : Tidak' WHEN rm.iskontrolya = '1' THEN 'Kontrol Ke Poli :' || ' ' || rm.kontrol END AS tindaklanjut,
    CASE WHEN rm.iskontroltidak = '1' THEN 'Pada Tanggal : -' WHEN rm.iskontrolya = '1' THEN 'Pada Tanggal :' || ' ' || TO_CHAR(rm.tglkontrol, 'DD-MM-YYYY') END AS tindaklanjutx
FROM
    emrpasien_t AS ep
LEFT OUTER JOIN
    resumemedis_t AS rm ON rm.emrpasienfk = ep.noemr
LEFT OUTER JOIN
    pegawai_m AS pg ON pg.id = rm.pegawaifk
LEFT OUTER JOIN
    pasien_m AS ps ON ps.nocm = ep.nocm
INNER JOIN
    jeniskelamin_m AS jk ON jk.id = ps.objectjeniskelaminfk
WHERE
    (rm.noregistrasifk = $P{norec_apd})
AND
    (rm.statusenabled = true)]]>
	</queryString>
