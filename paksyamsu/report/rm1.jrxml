	<parameter name="ruangan" class="java.lang.String"/>
	<parameter name="tglregistrasi" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
	date_part( 'year', age( tgllahir ) ) || ' Tahun ' || date_part( 'month', age( tgllahir ) ) || ' Bulan ' || date_part( 'day', age( tgllahir ) ) || ' Hari ' AS umur,alamat_m.alamatlengkap ,pasien_m.nohp, pasien_m.namapasien
FROM
	pasien_m
	INNER JOIN alamat_m ON pasien_m.ID = alamat_m.nocmfk 
	where nocm= $P{nocm}
union all
SELECT
	date_part( 'year', age( tgllahir ) ) || ' Tahun ' || date_part( 'month', age( tgllahir ) ) || ' Bulan ' || date_part( 'day', age( tgllahir ) ) || ' Hari ' AS umur,alamat_m.alamatlengkap ,pasien_m.nohp, pasien_m.namapasien
FROM
	pasien_m
	INNER JOIN alamat_m ON pasien_m.ID = alamat_m.nocmfk 
	where nocm= $P{nocm}]]>
	</queryString>
