	<queryString>
		<![CDATA[select * from pasiendaftar_t  as pd
left join tatalaksanaemr_t as tm on  tm.noregistrasi = pd.noregistrasi
right join pasien_m as ps on ps.id = pd.nocmfk
where pd.noregistrasi=$P{nocm} and jenis = 'obat']]>
	</queryString>
