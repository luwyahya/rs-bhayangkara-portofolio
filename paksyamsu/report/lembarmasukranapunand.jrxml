	<parameter name="namaRS" class="java.lang.String"/>
	<parameter name="gambarLogo" class="java.awt.Image"/>
	<parameter name="alamatRS" class="java.lang.String"/>
	<parameter name="noregistrasi" class="java.lang.String"/>
	<parameter name="pegawai" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
	ps.nocm,
	ps.namapasien,
	jk.jeniskelamin,
	date_part( 'year', age( ps.tgllahir ) ) || ' Tahun ' || date_part( 'month', age( ps.tgllahir ) ) || ' Bulan ' || date_part( 'day', age( ps.tgllahir ) ) || ' Hari ' AS umur,
to_char( ps.tgllahir, 'DD/TMMon/YYYY' ) as tgllahir,
	ps.penanggungjawab,
	hubungankeluargapj,
	ps.teleponpenanggungjawab,
	alamatrmh,
	alm.alamatlengkap,
	pdd.pendidikan,
	pkj.pekerjaan,
		ps.notelepon,
	rasal.namaruangan,
	pd.noregistrasi,
	to_char( apd.tglmasuk, 'DD/TMMon/YYYY' ) as tglregistrasi,
	to_char(apd.tglmasuk, 'HH24:MI:SS' ) as jamregistrasi,
	to_char( pd.tglpulang, 'DD/TMMon/YYYY' ) as tglpulang,
	to_char( pd.tglpulang, 'HH24:MI:SS' ) as jampulang,spw.statusperkawinan,
	ag.agama,aj.asalrujukan
	
FROM
	pasien_m AS ps
	INNER JOIN pasiendaftar_t AS pd ON ps.ID = pd.nocmfk
	LEFT JOIN jeniskelamin_m AS jk ON ps.objectjeniskelaminfk = jk."id"
	LEFT JOIN alamat_m AS alm ON ps.ID = alm.nocmfk
	LEFT JOIN pendidikan_m AS pdd ON pdd.ID = ps.objectpendidikanfk
	LEFT JOIN pekerjaan_m AS pkj ON ps.objectpekerjaanfk = pkj.
	ID LEFT JOIN ruangan_m AS rasal ON pd.objectruanganasalfk = rasal.
	ID INNER JOIN antrianpasiendiperiksa_t AS apd ON pd.norec = apd.noregistrasifk
	LEFT JOIN ruangan_m AS rapd ON apd.objectruanganfk = rapd.
	ID LEFT JOIN asalrujukan_m AS aj ON apd.objectasalrujukanfk = aj."id" 
		left join statusperkawinan_m as spw on ps.objectstatusperkawinanfk = spw.id
			left join agama_m as ag on ps.objectagamafk=ag.id
WHERE pd.noregistrasi=$P{noregistrasi} and
	rapd.objectdepartemenfk = '16'  and apd.statusenabled=true
ORDER BY
	apd.tglmasuk ASC 
	LIMIT 1]]>
	</queryString>
