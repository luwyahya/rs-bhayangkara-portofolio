	<parameter name="norec_pp" class="java.lang.String"/>
	<parameter name="qrcode" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT        ps.nocm, ps.namapasien, jk.reportdisplay, pp.tglpelayanan, pp.produkfk, pr.namaproduk, pr.namaexternal, pp.jumlah, pp.hargasatuan, pp.hargadiscount, sp.nostruk, pd.noregistrasi, ru.namaruangan, dp.namadepartemen, 
                         ps.id AS psid, apd.norec AS norec_apd, sp.norec AS norec_sp, pp.norec AS norec_pp, ru.objectdepartemenfk, so.noorder, ris.order_key AS idbridging, apd.objectruanganfk, pp.iscito, pp.jasa, ps.objectjeniskelaminfk, ps.tgllahir, 
                         pg.namalengkap AS dokterpengirim, pg.id AS iddokterpengirim, CASE WHEN ris.order_key IS NOT NULL THEN 'Sudah Dikirim' ELSE '-' END AS statusbridging, hr.norec AS hr_norec, CASE WHEN hr.nofoto IS NOT NULL 
                         THEN hr.nofoto ELSE '-' END AS nofoto, CASE WHEN hr.nofoto IS NOT NULL THEN 1 ELSE 0 END AS statusperiksa
FROM            pelayananpasien_t AS pp INNER JOIN
                         antrianpasiendiperiksa_t AS apd ON apd.norec = pp.noregistrasifk INNER JOIN
                         pasiendaftar_t AS pd ON pd.norec = apd.noregistrasifk INNER JOIN
                         pasien_m AS ps ON ps.id = pd.nocmfk LEFT OUTER JOIN
                         jeniskelamin_m AS jk ON jk.id = ps.objectjeniskelaminfk INNER JOIN
                         produk_m AS pr ON pr.id = pp.produkfk INNER JOIN
                         ruangan_m AS ru ON ru.id = apd.objectruanganfk INNER JOIN
                         departemen_m AS dp ON dp.id = ru.objectdepartemenfk LEFT OUTER JOIN
                         strukpelayanan_t AS sp ON sp.norec = pp.strukfk LEFT OUTER JOIN
                         strukorder_t AS so ON so.norec = pp.strukorderfk LEFT OUTER JOIN
                         pegawai_m AS pg ON pg.id = pp.objectpegawaipengirimfk LEFT OUTER JOIN
                         ris_order AS ris ON ris.order_no = so.noorder AND ris.order_code = pp.produkfk LEFT OUTER JOIN
                         hasilradiologi_t AS hr ON hr.pelayananpasienfk = pp.norec AND hr.statusenabled = true
WHERE        (ru.objectdepartemenfk = 27) AND pp.norec in ($P!{norec_pp})]]>
	</queryString>
