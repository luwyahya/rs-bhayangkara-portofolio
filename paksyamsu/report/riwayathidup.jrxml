	<parameter name="notelp" class="java.lang.String"/>
	<parameter name="dikjur" class="java.lang.String"/>
	<parameter name="tahundikjur" class="java.lang.String"/>
	<parameter name="nonformal" class="java.lang.String"/>
	<parameter name="jabatan" class="java.lang.String"/>
	<parameter name="jasa" class="java.lang.String"/>
	<parameter name="asing" class="java.lang.String"/>
	<parameter name="daerah" class="java.lang.String"/>
	<parameter name="tglsekarang" class="java.lang.String"/>
	<parameter name="qrcode" class="java.lang.String"/>
	<parameter name="foto" class="java.lang.String"/>
	<parameter name="gambarLogo" class="java.awt.Image"/>
	<queryString>
		<![CDATA[select
pg.namalengkap,
case when pg.objectgolonganfk is not null then glg.namaexternal || ' - ' || glg.golonganpegawai || ' / ' || pg.nippns when pg.objectpangkatpolisifk is not null then pp.namapangkatpolisi || ' / ' || pg.nrp else '-' end as golonganpegawai,
jk.jeniskelamin,
gd.golongandarah,
ag.agama,
spg.statusperkawinan,
pg.alamat,
pg.nohandphone,
pg.photo
from pegawai_m as pg left join
golonganpegawai_m as glg on glg.id = pg.objectgolonganfk left join
jeniskelamin_m as jk on jk.id = pg.objectjeniskelaminfk left join
golongandarah_m as gd on gd.id = pg.objectgolongandarahfk left join
agama_m as ag on ag.id = pg.objectagamafk left join
statusperkawinanpegawai_m as spg on spg.id = pg.objectstatusperkawinanpegawaifk left join
pangkatpolisi_m as pp on pp.id = pg.objectpangkatpolisifk
where pg.id = $P!{idPegawai}]]>
	</queryString>
