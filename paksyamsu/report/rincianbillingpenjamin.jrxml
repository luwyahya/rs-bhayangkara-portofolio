	<parameter name="totalpenjamin2" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT ROW_NUMBER
	( ) OVER ( PARTITION BY temp_billing_t.noregistrasi ORDER BY jenisproduk, ruangantindakan, tglpelayanan, namaproduk ) AS rownum,
	temp_billing_t.*,
	tglpelayanan AS tglpelayananx,
	to_char( totalppenjamin :: BIGINT, 'L9G999G999D99' ) AS totalpenjamin,
	to_char( ptp.penjamin1 :: BIGINT, 'L9G999G999D99' ) AS penjamin1,
	to_char( ptp.penjamin2 :: BIGINT, 'L9G999G999D99' ) AS penjamin2,
	to_char( ptp.pasien :: BIGINT, 'L9G999G999D99' ) AS pasien,
	kp.kelompokpasien,
	kp2.kelompokpasien AS kelompokpasien2,
	rk.namarekanan as namarekanan1,
	rk2.namarekanan AS namarekanan2 
FROM
	temp_billing_t
	INNER JOIN pembayarantindakanperpenjamin_t AS ptp ON ptp.norecpp = temp_billing_t.norec_pp
	LEFT JOIN  rekanan_m AS rk ON rk.ID :: VARCHAR = ptp.idrekanan1
	LEFT JOIN  kelompokpasien_m AS kp ON kp.ID :: VARCHAR = ptp.jenis1
	LEFT JOIN  rekanan_m AS rk2 ON rk2.ID :: VARCHAR = ptp.idrekanan2
	LEFT JOIN  kelompokpasien_m AS kp2 ON kp2.ID :: VARCHAR = ptp.jenis2 
WHERE
	temp_billing_t.noregistrasi = '$P!{noregistrasi}' 
	AND tglpelayanan IS NOT NULL 
	AND namaproduk NOT IN ( 'Biaya Administrasi', 'Biaya Materai' ) 
ORDER BY
	jenisproduk,
	ruangantindakan,
	tglpelayanan,
	namaproduk]]>
	</queryString>
