	<parameter name="tanggal" class="java.lang.String"/>
	<queryString>
		<![CDATA[select ROW_NUMBER() OVER (ORDER BY ru.namaruangan) as nomor,
ru.namaruangan, 
sum (case when salary is null then 0 else 1 end) as personil, 
sum (case when salary is null then 0 else salary end) as salary2
from pegawai_m as pg left join 
ruangan_m as ru on ru.id = pg.objectruangankerjafk where 
pg.namalengkap not in ('-', '- (Dokter Belum Diinput)', '- (Petugas Pelaksana Belum Diinput)') 
and pg.statusenabled = 1 
and pg.id not in (2, 890, 27676, 27733, 27746)
and pg.objectruangankerjafk is not null
group by ru.namaruangan]]>
	</queryString>
	<field name="nomor" class="java.lang.Integer">
		<property name="property.name" value="value"/>
	</field>
	<field name="namaruangan" class="java.lang.String">
		<property name="property.name" value="value"/>
	</field>
	<field name="salary2" class="java.math.BigDecimal">
		<property name="property.name" value="value"/>
	</field>
	<field name="personil" class="java.lang.Integer">
		<property name="property.name" value="value"/>
	</field>
