	<queryString>
		<![CDATA[SELECT
	ps.namapasien,
	jk.jeniskelamin,
	ps.nocm,
 to_char(	ps.tgllahir,'MON-DD-YYYY HH12:MIPM' :: TEXT) AS tgllahir,
	ps.namaayah,
	ps.noidentitas,
	CASE
WHEN ps.namakeluarga IS NULL THEN
	'-'
ELSE
	ps.namakeluarga
END AS namakeluarga,
 ps.namasuamiistri,
 ps.objectjeniskelaminfk,
 ps.objectstatusperkawinanfk
FROM            pasien_m AS ps INNER JOIN
                         jeniskelamin_m AS jk ON jk.id = ps.objectjeniskelaminfk
where ps.id =$P{norec}]]>
	</queryString>
