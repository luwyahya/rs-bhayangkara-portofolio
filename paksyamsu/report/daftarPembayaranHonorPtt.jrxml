	<parameter name="tanggal" class="java.lang.String"/>
	<parameter name="idruangan" class="java.lang.String"/>
	<queryString>
		<![CDATA[select ROW_NUMBER() OVER (ORDER BY pg.id) as nomor,
 pg.namalengkap,
case when pg.objectpendidikanterakhirfk is null then '-' else pnd.pendidikan end as pendidikan,
case when pg.tglmasuk is not null then convert(varchar, pg.tglmasuk, 105)  else '-' end as tglmasuk,
pg.salary 
 from pegawai_m as pg inner join
ruangan_m as ru on ru.id = pg.objectruangankerjafk left join
pendidikan_m as pnd on pnd.id = pg.objectpendidikanterakhirfk
where pg.objectruangankerjafk = $P{idruangan}
and pg.namalengkap not in ('-', '- (Dokter Belum Diinput)', 'Administrator', '- (Petugas Pelaksana Belum Diinput)')
and pg.kedudukanfk = 1
and pg.statusenabled = 1]]>
	</queryString>
	<field name="namalengkap" class="java.lang.String">
