	<parameter name="namaRS" class="java.lang.String"/>
	<parameter name="tgllahir" class="java.util.Date"/>
	<parameter name="gambarLogo" class="java.awt.Image"/>
	<parameter name="alamatRS" class="java.lang.String"/>
	<parameter name="printedBy" class="java.lang.String"/>
	<parameter name="noregistrasi" class="java.lang.String"/>
	<parameter name="lastruangan" class="java.lang.String"/>
	<parameter name="total" class="java.lang.String"/>
	<parameter name="kelas" class="java.lang.String"/>
	<parameter name="namakamar" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
	unit,
	namakelaspd,
	tipepasien,
	ROW_NUMBER ( ) OVER ( ORDER BY tglpelayanan, namaproduk ) AS nourut,
	CAST ( tglpelayanan AS DATE ) AS tglpelayanan,
	norec_pp,
	tglstruk,
	nobilling,
	noregistrasi,
	nocm,
	namapasienjk,
	unit AS ruangantindakan,
	objectdepartemenfk,
	dokterpj,
	tglregistrasi,
	tglpulang,
	namarekanan,
	SUBSTRING ( namaproduk, 5, 255 ) AS namaproduk,
	'-' AS penulisresep,
	'-' AS jenisproduk,
	dokter,
	SUM ( jumlah ) AS jumlah,
	hargajual,
	SUM ( total ) AS total,
	namakamar,
	tipepasien,
	totalharusdibayar,
	totalprekanan,
	totalppenjamin,
	totalbiayatambahan
FROM
	(
	SELECT
		norec_pp,
		tglstruk,
		noregistrasi AS nobilling,
		noregistrasi,
		nocm,
		namapasienjk,
		unit AS unit,
		objectdepartemenfk,
		namakelas,
		dokterpj,
		tglregistrasi,
		tglpulang,
		namarekanan,
		tglpelayanan,
		ruangantindakan,
		namaproduk,
		penulisresep,
		jenisproduk,
		dokter,
		jumlah,
		hargajual,
		diskon,
		total,
		namakamar,
		tipepasien,
		totalharusdibayar,
		0 AS totalprekanan,
		0 AS totalppenjamin,
		0 AS totalbiayatambahan,
		hargajual AS hargajual_kelasasal,
		hargajual * jumlah AS total_kelasasal,
		jenisprodukmaster,
		0 AS totaldibayar,
		USER AS namauser,
		SUBSTRING ( ruangantindakan, 1, 10 ) AS ruangan,
		namakelaspd
	FROM
		temp_billing_t
	WHERE
		( noregistrasi = $P{noregistrasi} )
		AND ( tglpelayanan IS NOT NULL )
		AND ( namaproduk NOT IN ( 'Biaya Administrasi', 'Biaya Materai' ) )
		AND ( penulisresep IS NOT NULL )
	) AS x
GROUP BY
	tglpelayanan,
	norec_pp,
	tglstruk,
	nobilling,
	noregistrasi,
	nocm,
	namapasienjk,
	unit,
	objectdepartemenfk,
	dokterpj,
	tglregistrasi,
	tglpulang,
	namarekanan,
	ruangan,
	dokter,
	namakamar,
	tipepasien,
	totalharusdibayar,
	totalprekanan,
	totalppenjamin,
	totalbiayatambahan,
	namauser,
	hargajual,
	namaproduk,
	namakelaspd UNION ALL
SELECT
	ruangan_m.namaruangan AS unit,
	'' AS namakelaspd,
	kelompokpasien_m.kelompokpasien AS tipepasien,
	ROW_NUMBER ( ) OVER ( ORDER BY tglpelayanan ) + 1000 AS nourut,
	CAST ( A.tglpelayanan AS DATE ) AS tglpelayanan,
	'-' AS norec_pp,
	NULL AS tglstruk,
	'-' AS nobiling,
	b.noregistrasi,
	ps.nocm,
	ps.namapasien AS namapasienjk,
	ruangan_m.namaruangan || ' ' || noresep :: VARCHAR ( 255 ) AS ruangantindakan,
	0 AS objectdepartemenfk,
	'' AS dokterpj,
	b.tglregistrasi,
	b.tglpulang,
CASE

		WHEN b.objectrekananfk IS NULL THEN
		'Umum' ELSE rk.namarekanan
	END AS namarekanan,
	SUBSTRING ( pr.namaproduk, 5, 255 ) AS namaproduk,
	'-' AS penulisresep,
	'-' AS jenisproduk,
	'' AS dokter,
	SUM ( A.qty ) AS jumlah,
	A.harga,
	SUM ( A.qty * A.harga ) AS total,
	'-' AS namakamar,
	'' AS tipepasien,
	0 AS totalharusdibayar,
	0 AS totalprekanan,
	0 AS totalppenjamin,
	0 AS totalbiayatambahan
FROM
	ruangan_m
	INNER JOIN antrianpasiendiperiksa_t ON ruangan_m.ID = antrianpasiendiperiksa_t.objectruanganfk
	INNER JOIN pelayananobattap_t
	AS A INNER JOIN produk_m AS pr ON A.objectprodukfk = pr.
	ID INNER JOIN pasiendaftar_t AS b ON A.noregistrasi = b.noregistrasi
	INNER JOIN pasien_m AS ps ON b.nocmfk = ps.ID ON antrianpasiendiperiksa_t.norec = A.norecapd
	LEFT OUTER JOIN kelompokpasien_m ON b.objectkelompokpasienlastfk = kelompokpasien_m.
	ID LEFT OUTER JOIN rekanan_m AS rk ON b.objectrekananfk = rk.ID
WHERE
	( A.noregistrasi = $P{noregistrasi} )
GROUP BY
	A.tglpelayanan,
	b.tglregistrasi,
	b.tglpulang,
	pr.namaproduk,
	A.harga,
	b.noregistrasi,
	ps.nocm,
	ps.namapasien,
	b.objectrekananfk,
	rk.namarekanan,
	ruangan_m.namaruangan,
	noresep,
	kelompokpasien_m.kelompokpasien


	]]>
	</queryString>
