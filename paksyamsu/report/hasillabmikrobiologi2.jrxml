	<parameter name="namaRS" class="java.lang.String"/>
	<parameter name="namaRSS" class="java.lang.String"/>
	<parameter name="namaRSSS" class="java.lang.String"/>
	<parameter name="tgllahir" class="java.util.Date"/>
	<parameter name="gambarLogo" class="java.awt.Image"/>
	<parameter name="alamatRS" class="java.lang.String"/>
	<parameter name="printedBy" class="java.lang.String"/>
	<parameter name="norecapd" class="java.lang.String"/>
	<parameter name="umur" class="java.lang.String"/>
	<parameter name="jeniskelamin" class="java.lang.String"/>
	<parameter name="tglpelayanan" class="java.lang.String"/>
	<parameter name="tglhasil" class="java.lang.String"/>
	<parameter name="dokter" class="java.lang.String"/>
	<parameter name="ruangan" class="java.lang.String"/>
	<parameter name="analis" class="java.lang.String"/>
	<parameter name="linkqr" class="java.lang.String"/>
	<parameter name="Diagnosa" class="java.lang.String"/>
	<parameter name="dokterPeriksa" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select
	distinct *
from
	(
	SELECT
		pp.tglpelayanan,
		maps.nourutdetail,
		rj.namaruangan AS ruanganperejuk,
		pm.nocm,
		pd.noregistrasi,
		so.noorder,
		pm.namapasien,
		alm.alamatlengkap,
		kp.kelompokpasien,
		rkn.namarekanan,
		pd.tglregistrasi,
		CONVERT(varchar,
		pd.tglregistrasi,
		105) AS tglRegiss,
		pp.tglpelayanan AS tglawal,
		pg1.namalengkap AS dokterperiksa,
		pg2.namalengkap AS dokterperiksaedi,
		pm.tgllahir,
		CONVERT(varchar,
		pm.tgllahir,
		105) AS tglLahirs,
		djp.detailjenisproduk,
		prd.namaproduk,
		maps.detailpemeriksaan,
		maps.memohasil,
		ss.satuanstandar,
		nn.nilaitext,
		nn.nilaimin,
		nn.nilaimax,
		hh.hasil,
		jk.jeniskelamin,
		apd.tglmasuk AS tglverif,
		hh.tglhasil AS tglakhir,
		hh.flag,
		hh.hasil_s,
		hh.hasil_i,
		hh.catatan,
        hh.catatancetak
	FROM
		pelayananpasien_t AS pp
	INNER JOIN antrianpasiendiperiksa_t AS apd ON
		apd.norec = pp.noregistrasifk
	INNER JOIN pasiendaftar_t AS pd ON
		pd.norec = apd.noregistrasifk
	LEFT OUTER JOIN strukorder_t AS so ON
		so.norec = apd.objectstrukorderfk
	LEFT OUTER JOIN ruangan_m AS rj ON
		pd.objectruanganlastfk = rj.id
	INNER JOIN pasien_m AS pm ON
		pm.id = pd.nocmfk
	LEFT OUTER JOIN jeniskelamin_m AS jk ON
		jk.id = pm.objectjeniskelaminfk
	LEFT OUTER JOIN alamat_m AS alm ON
		alm.nocmfk = pm.id
	LEFT OUTER JOIN kelompokpasien_m AS kp ON
		kp.id = pd.objectkelompokpasienlastfk
	LEFT OUTER JOIN rekanan_m AS rkn ON
		rkn.id = pd.objectrekananfk
	LEFT OUTER JOIN pegawai_m AS pg ON
		pg.id = so.objectpegawaiorderfk
	LEFT OUTER JOIN pegawai_m AS pg1 ON
		pg1.id = apd.objectpegawaifk
	LEFT OUTER JOIN produk_m AS prd ON
		prd.id = pp.produkfk
	LEFT OUTER JOIN pelayananpasienpetugas_t AS p3 ON
		pp.norec = p3.pelayananpasien
	INNER JOIN pegawai_m AS pg2 ON
		pg2.id = p3.objectpegawaifk
	INNER JOIN detailjenisproduk_m AS djp ON
		djp.id = prd.objectdetailjenisprodukfk
	INNER JOIN maphasillab_m AS maps ON
		maps.produkfk = prd.id
	INNER JOIN maphasillabdetail_m AS maps2 ON
		maps2.maphasilfk = maps.id
		AND maps2.jeniskelaminfk = $P{jeniskelamin}
		AND maps2.kelompokumurfk IN (
		SELECT
			id
		FROM
			kelompokumur_m AS kuu
		WHERE
			( $P{umur} BETWEEN umurmin AND umurmax))
	LEFT OUTER JOIN pegawai_m AS pg3 ON
		pg3.id = p3.objectpegawaifk
		AND p3.objectpegawaifk = '4'
	INNER JOIN nilainormal_m AS nn ON
		nn.id = maps2.nilainormalfk
	LEFT OUTER JOIN satuanstandar_m AS ss ON
		ss.id = maps.satuanstandarfk
	LEFT OUTER JOIN hasillaboratorium_t AS hh ON
		hh.norecpelayanan = pp.norec
		AND pp.noregistrasifk = hh.noregistrasifk
		AND maps.detailpemeriksaan = hh.detailpemeriksaan
		and maps.id = hh.maphasilfk
	$P!{norecapd}) as data
order by
	data.nourutdetail asc]]>
	</queryString>
