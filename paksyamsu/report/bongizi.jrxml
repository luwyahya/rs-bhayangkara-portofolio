	<queryString>
		<![CDATA[SELECT        MenuGizi_t.tglmenu, SUM(MenuGizi_t.jumlah) AS total, produk_m_1.namaproduk AS bahan, satuanbesar_m.satuanbesar
FROM            MenuGizi_t INNER JOIN
                         produk_m ON MenuGizi_t.idproduk = produk_m.id INNER JOIN
                         produk_m AS produk_m_1 ON MenuGizi_t.produkfkbahan = produk_m_1.id INNER JOIN
                         satuanbesar_m ON produk_m.objectsatuanstandarfk = satuanbesar_m.id
        where  Menugizi_t.tglmenu between $P{tglAwal} and  $P{tglAkhir} and  produk_m_1.objectdetailjenisprodukfk=$P{kodedetailproduk}
GROUP BY MenuGizi_t.tglmenu, produk_m_1.namaproduk, satuanbesar_m.namaexternal,satuanbesar_m.satuanbesar
ORDER BY bahan]]>
	</queryString>
	<field name="tglmenu" class="java.lang.String"/>
	<field name="total" class="java.lang.String"/>
	<field name="bahan" class="java.lang.String"/>
	<field name="satuanbesar" class="java.lang.String"/>
