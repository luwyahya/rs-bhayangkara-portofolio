	<parameter name="norec" class="java.lang.String"/>
	<queryString>
		<![CDATA[select op.jumlah,op.hargasatuan*op.hasilkonversi as hargasatuan ,so.tglorder,so.nokontrakspk,cast(so.tglkontrak as date) as tglkontrak,so.keteranganlainnya,so.noorderhps,so.tglvalidasi,so.nourutlogin,so.keterangankeperluan,so.noorder, so.keterangankeperluan,so.noorderintern, cast(so.tglorder as date) as tglorder, so.keteranganorder, so.nokontrakspk,so.noorderrfq,so.namarekanansales,so.alamat,so.alamattempattujuan,pr.namaproduk,so.totalbiayakirim,ssx.satuanstandar, op.qtyproduk, op.hargadiscount,op.hargappn, case when op.hargadiscount <> 0 then (op.hargasatuan * op.qtyproduk) / op.hargadiscount else 0 end as persenDisc, 
case when op.hargappn <> 0 then (op.hargasatuan * op.qtyproduk) / op.hargappn else 0 end as persenPpn, (op.hargasatuan * op.qtyproduk)-(hargadiscount+hargappn)as total,pg.namalengkap,pg1.namalengkap as pegawaispk, case when pg.nippns is null then '-' ELSE pg.nippns end as nippns, case when pg1.nippns is null then '-' ELSE pg1.nippns end AS nippns_spk, rk.namarekanan,rk.alamatlengkap,op.deskripsiprodukquo, mp.objectjabatanppkfk, case when jb.namajabatan is null then '-' ELSE jb.namajabatan end AS jabatanppk, case when jb1.namajabatan is null then '-' ELSE jb1.namajabatan end AS namajabatan , so.keteranganorder    
from strukorder_t so left join orderpelayanan_t op on op.strukorderfk=so.norec left join produk_m pr on pr.id=op.objectprodukfk left join satuanstandar_m ss on ss.id=op.objectsatuanstandarfk left join satuanstandar_m ssx on ssx.id=op.satuanviewfk left join pegawai_m as pg on pg.id = so.objectpegawaiorderfk left join pegawai_m as pg1 on pg1.id = so.objectpegawaispkfk left join mapjabatanppktopegawai_m as mp on mp.objectpegawaifk=pg1.id left join jabatanppk_m as jb on jb.id = mp.objectjabatanppkfk left join jabatan_m as jb1 on jb1.id = pg1.objectjabatanstrukturalfk left join rekanan_m as rk on rk.id = so.objectrekananfk 

where so.norec=$P{norec}]]>
	</queryString>
