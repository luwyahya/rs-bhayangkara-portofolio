	<parameter name="namaRS" class="java.lang.String"/>
	<parameter name="gambarLogo" class="java.awt.Image"/>
	<parameter name="alamatRS" class="java.lang.String"/>
	<parameter name="tglawal" class="java.lang.String"/>
	<parameter name="tglakhir" class="java.lang.String"/>
	<queryString>
		<![CDATA[select sum(totalf) as totalF,sum(qtyproduk) as qty ,tglstruk,sum(obat) as obat,sum(alkes) as alkes,sum(alatoperasi)as alatoperasi from(

select x.totalF, x.total, x.qtyproduk, x.tglstruk, case when x.detailjenisproduk='obat' then x.totalF else 0 end as obat,case when x.detailjenisproduk='alkes' then x.totalF else 0 end as alkes,case when x.detailjenisproduk='alat operasi' then x.totalF else 0 end as alatoperasi
from (SELECT        SUM(totalF) AS totalF, SUM(total) AS total, SUM(qtyproduk) AS qtyproduk, namarekanan, detailjenisproduk, cast(tglstruk as date) as tglstruk
FROM            V_LaporanPenerimaanSupplierGetReport
WHERE        (tglstruk >= $P{tglawal}) AND (tglstruk <= $P{tglakhir}) 
GROUP BY namarekanan, detailjenisproduk, cast(tglstruk as date)) as x 
) as y
group by tglstruk
order by tglstruk asc]]>
	</queryString>
