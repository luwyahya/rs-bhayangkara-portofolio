	<queryString>
		<![CDATA[SELECT        CASE WHEN cb.id = 1 THEN sbm.totaldibayar ELSE 0 END AS tunai, CASE WHEN cb.id = 4 THEN sbm.totaldibayar ELSE 0 END AS nontunai,CASE WHEN cb.id = 3 THEN sbm.totaldibayar ELSE 0 END AS tf, CASE WHEN pd.noregistrasi IS NULL 
                         THEN sp.nostruk ELSE pd.noregistrasi END AS noregistrasi, sbm.tglsbm, ps.nocm, CASE WHEN ps.namapasien IS NULL THEN sp.namapasien_klien ELSE ps.namapasien END AS namapasien, 
                         CASE WHEN kp.kelompokpasien IS NULL THEN 'Non Layanan' ELSE kp.kelompokpasien END AS kelompokpasien, ru.namaruangan, pg.namalengkap, pg2.namaexternal AS kasir, sbm.totaldibayar, 
                         CASE WHEN sp.totalprekanan IS NULL THEN 0 ELSE sp.totalprekanan END AS hutangPenjamin, sp.totalharusdibayar, lu.namaexternal AS namaLogin
FROM            strukbuktipenerimaan_t AS sbm LEFT OUTER JOIN
                         strukbuktipenerimaancarabayar_t AS sbmc ON sbmc.nosbmfk = sbm.norec LEFT OUTER JOIN
                         carabayar_m AS cb ON cb.id = sbmc.objectcarabayarfk INNER JOIN
                         strukpelayanan_t AS sp ON sp.norec = sbm.nostrukfk LEFT OUTER JOIN
                         loginuser_s AS lu ON lu.id = sbm.objectpegawaipenerimafk LEFT OUTER JOIN
                         pegawai_m AS pg2 ON pg2.id = lu.objectpegawaifk LEFT OUTER JOIN
                         pasiendaftar_t AS pd ON pd.norec = sp.noregistrasifk LEFT OUTER JOIN
                         pasien_m AS ps ON ps.id = sp.nocmfk LEFT OUTER JOIN
                         jeniskelamin_m AS jk ON jk.id = ps.objectjeniskelaminfk LEFT OUTER JOIN
                         pegawai_m AS pg ON pg.id = pd.objectpegawaifk LEFT OUTER JOIN
                         ruangan_m AS ru ON ru.id = pd.objectruanganlastfk LEFT OUTER JOIN
                         kelompokpasien_m AS kp ON kp.id = pd.objectkelompokpasienlastfk
                        $P!{kondisi}]]>
	</queryString>
