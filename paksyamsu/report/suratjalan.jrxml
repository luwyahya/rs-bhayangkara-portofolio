	<parameter name="namaRS" class="java.lang.String"/>
	<parameter name="gambarLogo" class="java.awt.Image"/>
	<parameter name="alamatRS" class="java.lang.String"/>
	<parameter name="printedBy" class="java.lang.String"/>
	<parameter name="noregistrasi" class="java.lang.String"/>
	<parameter name="defaultValue" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[new Integer("1")]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT    CASE
WHEN to_char (suratjalanambulance.tanggalberangkat,'d') = '1' THEN 'MINGGU'
WHEN to_char (suratjalanambulance.tanggalberangkat,'d') = '2' THEN 'SENIN'
WHEN to_char (suratjalanambulance.tanggalberangkat,'d') = '3' THEN 'SELASA'
WHEN to_char (suratjalanambulance.tanggalberangkat,'d') = '4' THEN 'RABU'
WHEN to_char (suratjalanambulance.tanggalberangkat,'d') = '5' THEN 'KAMIS'
WHEN to_char (suratjalanambulance.tanggalberangkat,'d') = '6' THEN 'JUMAT'
WHEN to_char (suratjalanambulance.tanggalberangkat,'d') = '7' THEN 'SABTU'
END hari,  suratjalanambulance.norec, suratjalanambulance.noregistrasi, cast(suratjalanambulance.tanggalberangkat as date) as tanggalberangkat, suratjalanambulance.nopol, suratjalanambulance.tujuan, suratjalanambulance.keperluan, suratjalanambulance.petugas, suratjalanambulance.keluargapasien, pegawai_m.namalengkap
FROM suratjalanambulance INNER JOIN pegawai_m ON suratjalanambulance.petugas = pegawai_m.id
where suratjalanambulance.noregistrasi=$P{noregistrasi}]]>
	</queryString>
