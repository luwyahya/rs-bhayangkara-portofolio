	<parameter name="noregistrasi" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT        pd.noregistrasi, ps.nocm, ps.tgllahir, ps.namapasien, pd.tglregistrasi, jk.reportdisplay AS jk, ap.alamatlengkap, ap.mobilephone2, ru.namaruangan AS ruanganPeriksa, pp.namalengkap AS namadokter, kp.kelompokpasien, 
                         apdp.noantrian, pd.statuspasien, ps.namaayah, rkn.namarekanan, pd.catatan
FROM            pasiendaftar_t AS pd INNER JOIN
                         pasien_m AS ps ON pd.nocmfk = ps.id INNER JOIN
                         alamat_m AS ap ON ap.nocmfk = ps.id INNER JOIN
                         jeniskelamin_m AS jk ON ps.objectjeniskelaminfk = jk.id INNER JOIN
                         ruangan_m AS ru ON pd.objectruanganlastfk = ru.id LEFT OUTER JOIN
                         pegawai_m AS pp ON pd.objectpegawaifk = pp.id INNER JOIN
                         kelompokpasien_m AS kp ON pd.objectkelompokpasienlastfk = kp.id INNER JOIN
                         antrianpasiendiperiksa_t AS apdp ON apdp.noregistrasifk = pd.norec and pd.objectruanganlastfk=apdp.objectruanganfk INNER JOIN

                         rekanan_m AS rkn ON pd.objectrekananfk = rkn.id
                         where pd.noregistrasi =$P{noregistrasi}]]>
	</queryString>
