	<parameter name="namaPasien" class="java.lang.String"/>
	<parameter name="gambarLogo" class="java.awt.Image"/>
	<parameter name="noemr" class="java.lang.String"/>
	<parameter name="norm" class="java.lang.String"/>
	<parameter name="jeniskelamin" class="java.lang.String"/>
	<parameter name="umur" class="java.lang.String"/>
