	<parameter name="ttd" class="java.lang.String"/>
	<parameter name="dpjp" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select DISTINCT ON (temp.tgljam, temp.hasilpemeriksaan)
	CAST ( TEMP.tgljam AS VARCHAR ) AS tgljam,
	temp.profesi,
	temp.hasilpemeriksaan,
	ps.tgllahir,
	temp.instruksitenaga,
	CASE WHEN temp.menyerahkan != '' 
		THEN concat('Yang Menyerahkan ', TEMP.menyerahkan)
		ELSE '' 
	END AS menyerahkan,
	CASE WHEN temp.menerima != ''
		THEN concat('Yang Menerima', TEMP.menerima)
		ELSE ''
	END AS menerima,
	CASE WHEN temp.pasienkeluarga != ''
		THEN concat('Pasien / Keluarga', TEMP.pasienkeluarga)
		ELSE ''
	END AS pasienkeluarga,
	temp.pegawai,
	CASE WHEN temp.tgllapor != 'Invalid date'
		THEN concat('Tanggal Lapor', CAST(TEMP.tgllapor AS VARCHAR))
		ELSE ''
	END AS lapor,
	CASE WHEN temp.tgljawab != 'Invalid date'
		THEN concat('Tanggal Jawab', CAST(TEMP.tgljawab AS VARCHAR))
		ELSE ''
	END AS instruksi,
	CASE WHEN temp.penerimainstruksi != ''
		THEN concat('Penerima Instruksi', TEMP.penerimainstruksi)
		ELSE ''
	END AS penerimainstruksi,
	CASE WHEN temp.pemberiinstruksi != ''
		THEN concat('Pemberi Instruksi', TEMP.pemberiinstruksi)
		ELSE ''
	END AS pemberiinstruksi,
	CASE WHEN temp.ttd != ''
		THEN concat('Penulis CPPT', TEMP.ttd)
		ELSE ''
	END AS ttd, ttp.tandatangan,
	CASE WHEN temp.pegawai IS NOT NULL
		THEN concat('http://simrs-rspusatpolri.com:9000/service/medifirst2000/report/cetak-ttd-new?idPegawai=', CAST ( pg2.ID AS VARCHAR ))
		ELSE 'Data Tidak Ditemukan'
	END AS qrcode  
FROM tempemr_t  AS temp
INNER JOIN emrpasien_t as emr ON emr.noemr = temp.emrpasienfk
INNER JOIN pasien_m AS ps ON ps.nocm = emr.nocm
LEFT JOIN pegawai_m AS pg ON pg.namalengkap = temp.ttd
LEFT JOIN tandatanganppa_t AS ttp ON ttp.objectpegawaifk::INTEGER = pg.id
LEFT JOIN pegawai_m AS pg2 ON pg2.namalengkap = temp.pegawai
WHERE emrpasienfk= $P{noemr} AND temp.statusenabled = true
ORDER BY temp.tgljam, temp.hasilpemeriksaan]]>
	</queryString>
