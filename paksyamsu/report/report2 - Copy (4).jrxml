	</subDataset>
	<subDataset name="masalah" uuid="637879af-7290-42d1-830f-8bfacd680583">
		<parameter name="namaRS" class="java.lang.String"/>
		<parameter name="gambarLogo" class="java.awt.Image"/>
		<parameter name="alamatRS" class="java.lang.String"/>
		<parameter name="norecemricu" class="java.lang.String"/>
		<queryString>
			<![CDATA[select * from masalahicu_t WHERE norecemricufk = $P{norecemricu}
order by jam]]>
		</queryString>
		<field name="jam" class="java.lang.String"/>
		<field name="masalah" class="java.lang.String"/>
		<field name="intruksi" class="java.lang.String"/>
		<field name="paraf" class="java.lang.String"/>
	</subDataset>
	<parameter name="norecemricu" class="java.lang.String"/>
	<parameter name="namaRS" class="java.lang.String"/>
	<parameter name="gambarLogo" class="java.awt.Image"/>
	<queryString>
		<![CDATA[SELECT        v_icu.[group], v_icu.[column], v_icu.a, v_icu.b, v_icu.c, v_icu.d, v_icu.e, v_icu.f, v_icu.g, v_icu.h, v_icu.i, v_icu.j, v_icu.k, v_icu.l, v_icu.m, v_icu.n, v_icu.o, v_icu.p, v_icu.q, v_icu.r, v_icu.s, v_icu.t, v_icu.u, v_icu.v,v_icu.w,  v_icu.x,  
                         mappingcetakanicu.nourut
FROM           tempviewicu as v_icu INNER JOIN
                         mappingcetakanicu ON v_icu.[column] = mappingcetakanicu.[column] AND v_icu.[group] = mappingcetakanicu.[group]
where v_icu.[group] like '%vital%' and norecemricu = $P{norecemricu}  
						 order by nourut]]>
	</queryString>
	<field name="a" class="java.lang.String"/>
