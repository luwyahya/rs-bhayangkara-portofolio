	<queryString>
		<![CDATA[SELECT MenuGizi_t.norec, MenuGizi_t.tglmenu, MenuGizi_t.idproduk, cast(MenuGizi_t.jumlah * produk_m.qtyterkecil as char) jumlah ,  case when MenuGizi_t.idjammakan =1 then 'MAKAN SIANG JAM: 12.00-13.00 WIB 'when
MenuGizi_t.idjammakan =2 then 'MAKAN MALAM JAM: 18.00-19.00 WIB' when MenuGizi_t.idjammakan =3 then 'MAKAN PAGI JAM: 06.00-07.00 WIB' end as jammakan, MenuGizi_t.statusenabled, MenuGizi_t.keterangan, produk_m.namaproduk, MenuGizi_t.produkfkbahan, produk_m_1.namaproduk AS bahan, satuankecil_m.satuankecil
FROM            MenuGizi_t INNER JOIN
                         produk_m ON MenuGizi_t.idproduk = produk_m.id INNER JOIN
                         produk_m AS produk_m_1 ON MenuGizi_t.produkfkbahan = produk_m_1.id LEFT OUTER JOIN
                         satuankecil_m ON produk_m.objectsatuankecilfk = satuankecil_m.id
                         where tglmenu between   $P{tglAwal} and  $P{tglAkhir}
                         order by idjammakan]]>
	</queryString>
