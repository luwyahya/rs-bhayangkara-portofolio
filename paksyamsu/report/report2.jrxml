	<queryString>
		<![CDATA[select pd.noregistrasi,ps.nocm,ps.namapasien,ps.tgllahir,jk.jeniskelamin,
apd.tglregistrasi,apd.tglmasuk,case when sk.satuankerjapasien is null then '-' else sk.satuankerjapasien end as satuankerjapasien,
case when pj.pekerjaan is null then '-' else pj.pekerjaan end as pekerjaan,al.alamatlengkap, ps.notelepon,to_char(apd.tglregistrasi,'HH24 : MI') AS jammasuk,to_char(apd.tglregistrasi,'HH24 : MI') AS jamregis from pasiendaftar_t pd
INNER JOIN antrianpasiendiperiksa_t apd on apd.noregistrasifk=pd.norec
INNER JOIN pasien_m ps on ps.id=pd.nocmfk
INNER JOIN jeniskelamin_m jk on jk.id=ps.objectjeniskelaminfk
LEFT JOIN satuankerjapasien_m sk on ps.objectsatuankerjafk=sk.id
LEFT JOIN pekerjaan_m pj on ps.objectpekerjaanfk=pj.id
LEFT JOIN alamat_m al on ps.id=al.nocmfk
where pd.noregistrasi=$P{nocm} and apd.objectruanganasalfk is null]]>
	</queryString>
