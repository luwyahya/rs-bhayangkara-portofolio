<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="antemortem_1" pageWidth="615" pageHeight="785" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="10" bottomMargin="0" uuid="e4bf3c46-bd94-4add-a0b5-c8105fe3754f">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter "/>
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="noregistrasi" class="java.lang.String"/>
	<queryString>
		<![CDATA[select fa.noregistrasi,case when fa.namapelapor is null then dp.namapelapor else fa.namapelapor end as namapelapor, case when fa.hubungankeluargafk is null then hk2.hubungankeluarga else hk.hubungankeluarga end as hubungankeluarga, case when fa.notelepon is null then dp.nohp else fa.notelepon end as notelepon,
case when fa.namadilaporkan is null then dp.namakorban else fa.namadilaporkan end as namadilaporkan, case when fa.jeniskelaminfk is null then jk2.jeniskelamin else jk.jeniskelamin end as jeniskelamin, case when fa.namapanggilan is null then dp.namaalias else fa.namapanggilan end as namapanggilan,
case when fa.alamat is null then dp.domisilikorban else fa.alamat end as alamat, case when fa.tgllahir is null then convert(varchar, dp.tgllahir, 105) else convert(varchar, fa.tgllahir, 105) end as tgllahir, case when fa.suku is null then su2.suku else su.suku end as suku,
ide.sumber as sumbersidikjari, fa.uraiansidikjari, fa.keterangansidikjari, ide2.sumber as sumbergigi, fa.uraiangigi, fa.keterangangigi, ide3.sumber as sumberdna, fa.uraiandna, fa.keterangandna,
case when fa.tgllahir is null then (CONVERT(int,CONVERT(char(8),GETDATE(),112))-CONVERT(char(8),dp.tgllahir,112))/10000 else (CONVERT(int,CONVERT(char(8),GETDATE(),112))-CONVERT(char(8),fa.tgllahir,112))/10000 end as usia,
fotoam.foto, convert(varchar, GETDATE(), 105) as tglsekarang,fa.ciricirifisik,fa.barangkepemilikan,fa.keteranganbarang,fa.keteranganfisik,
case when fa.jenisbencanafk is null then map2.jenisbencana else map.jenisbencana end as jenisbencana, case when fa.jenisbencanafk is null then convert(varchar, map2.tglbencana, 110) else convert(varchar, map.tglbencana, 110) end as tglbencana, case when fa.jenisbencanafk is null then convert(varchar, map2.tglbencana, 108) else convert(varchar, map.tglbencana, 108) end as waktubencana
from formulirantemortem_t as fa left join
dvipelapor_t as dp on dp.norec = fa.dvipelaporfk left join
fotoantemortem_t as fotoam on fotoam.formulirantemortemfk = fa.noregistrasi left join
hubungankeluarga_m as hk on hk.id = fa.hubungankeluargafk left join
jeniskelamin_m as jk on jk.id = fa.jeniskelaminfk left join
mappingjenisbencanatoformulirantemortem_t as map on map.id = fa.jenisbencanafk left join
hubungankeluarga_m as hk2 on hk2.id = dp.objecthubunganfk left join
jeniskelamin_m as jk2 on jk2.id = dp.objectjeniskelaminfk left join
suku_m as su2 on su2.id = dp.objectsukufk left join
suku_m as su on su.id = fa.suku left join
identitasdvi_t as ide on ide.id = fa.sumbersidikjari left join
identitasdvi_t as ide2 on ide2.id = fa.sumbergigi left join
identitasdvi_t as ide3 on ide3.id = fa.sumberdna left join
mappingjenisbencanatoformulirantemortem_t as map2 on map2.id = dp.objectjenisbencanafk
where fa.noregistrasi = $P{noregistrasi}]]>
	</queryString>
