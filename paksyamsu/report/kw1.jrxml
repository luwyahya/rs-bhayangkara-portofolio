	<queryString>
		<![CDATA[SELECT        pd.noregistrasi, ps.namapasien, '-' || ','  || namaruangan AS keteranganlainnya, ru.namaruangan, ps.nocm, pd.tglregistrasi, pd.tglpulang,
                       sbm.nosbm AS nobayar
FROM            pasiendaftar_t AS pd LEFT OUTER JOIN
                         ruangan_m AS ru ON ru.id = pd.objectruanganlastfk LEFT OUTER JOIN
                         pasien_m AS ps ON ps.id = pd.nocmfk LEFT OUTER JOIN
                         strukbuktipenerimaan_t AS sbm ON sbm.norec = pd.nosbmlastfk
WHERE        (pd.noregistrasi =$P{noRegistrasi} )]]>
	</queryString>
	<field name="noregistrasi" class="java.lang.String">
