<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cetakBuktiTeransfer" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="5c9a5275-3498-4b59-83da-69b01b7a1fcb">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="41"/>
	<property name="ireport.y" value="144"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="0"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="1000"/>
	<parameter name="totaluang" class="java.lang.String"/>
	<parameter name="norec" class="java.lang.String"/>
	<parameter name="namaRS" class="java.lang.String"/>
	<parameter name="namaRSS" class="java.lang.String"/>
	<parameter name="alamatRS" class="java.lang.String"/>
	<parameter name="gambarLogo" class="java.awt.Image"/>
	<parameter name="jabatanKirim" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT        sk.tglkirim,case when so.tglorder  is null then sk.tglkirim else  so.tglorder end as tglorder, sk.nokirim, case when so.noorder is null then sk.nokirim else so.noorder end as noorder, jp.name, ru.namaruangan,ru.namaruangan AS ruangankirim, ru2.namaruangan AS ruangantujuan, pg.namalengkap, pr.id AS idproduk, case when pr.kdproduk is null then '-' else pr.kdproduk end AS kdsirs, pr.namaproduk, ss.satuanstandar, kp.qtyproduk, kp.qtyorder, kp.hargasatuan, kp.hargasatuan * kp.qtyproduk AS total, sk.keteranganlainnyakirim,
                        dp.namadepartemen AS pnjPengirim, pg.namalengkap AS pegawaipengirim,  pg.nippns AS nippengirim,  dp2.namadepartemen AS pnjPenerima, pg2.namalengkap AS pegawaipenerima,
                         pg2.nippns AS nippenerima, sp.tglfaktur
FROM            strukkirim_t AS sk LEFT OUTER JOIN
                         kirimproduk_t AS kp ON kp.nokirimfk = sk.norec LEFT OUTER JOIN
                         strukpelayanan_t AS sp ON sp.norec = kp.nostrukterimafk LEFT OUTER JOIN
                         strukorder_t AS so ON so.norec = sk.noorderfk LEFT OUTER JOIN
                         produk_m AS pr ON pr.id = kp.objectprodukfk LEFT OUTER JOIN
                         satuanstandar_m AS ss ON ss.id = pr.objectsatuanstandarfk LEFT OUTER JOIN
                         jenis_permintaan_m AS jp ON jp.id = sk.jenispermintaanfk LEFT OUTER JOIN
                         ruangan_m AS ru ON ru.id = sk.objectruanganasalfk LEFT OUTER JOIN
                         departemen_m AS dp ON dp.id = ru.objectdepartemenfk LEFT OUTER JOIN
                         ruangan_m AS ru2 ON ru2.id = sk.objectruangantujuanfk LEFT OUTER JOIN
                         departemen_m AS dp2 ON dp2.id = ru2.objectdepartemenfk LEFT OUTER JOIN
                         pegawai_m AS pg ON pg.id = sk.objectpegawaipengirimfk LEFT OUTER JOIN
                         pegawai_m AS pg2 ON pg2.id = sk.objectpegawaipenerimafk
WHERE        (sk.norec = $P{norec}) AND (kp.qtyproduk <> 0)
ORDER BY pr.namaproduk]]>
	</queryString>
	<field name="tglkirim" class="java.lang.String"/>
	<field name="tglorder" class="java.lang.String"/>
	<field name="nokirim" class="java.lang.String"/>
