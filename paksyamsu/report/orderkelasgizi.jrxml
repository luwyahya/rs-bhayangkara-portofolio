	<parameter name="kondisi" class="java.lang.String"/>
	<queryString>
		<![CDATA[select sum(x.KelasI) as KelasI,
sum(x.KelasII) as KelasII,
sum(x.KelasIII) as KelasIII,
sum(x.Intensive) as Intensive,
sum(x.VVIP) as VVIP,
sum(x.VIP) as VIP,
sum(x.KelasI + x.KelasII + x.KelasIII + x.Intensive + x.VIP + x.VVIP) as total2, x.tglorder from  
(SELECT      CASE WHEN namakelas = 'Kelas I' THEN   COUNT(*)  ELSE 0 END AS KelasI, CASE WHEN namakelas = 'Kelas II' THEN   COUNT(*)  ELSE 0 END AS KelasII, CASE WHEN namakelas = 'Kelas III' THEN   COUNT(*)  ELSE 0 END AS KelasIII, 
                         CASE WHEN namakelas = 'Intensive' THEN   COUNT(*)  ELSE 0 END AS Intensive, CASE WHEN namakelas = 'VIP' THEN   COUNT(*)  ELSE 0 END AS VIP,CASE WHEN namakelas = 'VVIP' THEN   COUNT(*)  ELSE 0 END AS VVIP, tglorder2 AS tglorder
FROM            v_labelgizi
WHERE        $P!{kondisi}
GROUP BY namakelas, tglorder2
) as x
group by tglorder
ORDER BY tglorder]]>
	</queryString>
