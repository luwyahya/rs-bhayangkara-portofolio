<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cetakLabPA" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="fb5f9a6a-63bc-4c78-ab2c-98bc4dcf1512">
	<property name="ireport.zoom" value="5.559917313492241"/>
	<property name="ireport.x" value="1916"/>
	<property name="ireport.y" value="1148"/>
	<parameter name="namaRS" class="java.lang.String"/>
	<parameter name="namaRSS" class="java.lang.String"/>
	<parameter name="namaRSSS" class="java.lang.String"/>
	<parameter name="tgllahir" class="java.util.Date"/>
	<parameter name="gambarLogo" class="java.awt.Image"/>
	<parameter name="alamatRS" class="java.lang.String"/>
	<parameter name="umur" class="java.lang.String"/>
	<parameter name="norec" class="java.lang.String"/>
	<parameter name="nopa" class="java.lang.String"/>
	<parameter name="dokLu" class="java.lang.String"/>
	<parameter name="top" class="java.lang.String"/>
	<parameter name="mof" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT        ps.nocm, ps.namapasien, ps.tgllahir, kp.kelompokpasien, ru.namaruangan, so.tanggal, jk.jeniskelamin, CASE WHEN alm.alamatlengkap IS NULL
                         THEN '-' ELSE (alm.alamatlengkap || ' ' || ds.namadesakelurahan || ' ' || kc.namakecamatan || ' ' || kk.namakotakabupaten || ' ' || pro.namapropinsi) END AS alamatlengkap,
                         CASE WHEN so.dokterperujuk = 1 THEN '-' ELSE pg3.namalengkap END AS dokterperujuk, CASE WHEN so.dokterperujukluar IS NULL THEN '-' ELSE so.dokterperujukluar END AS dokterperujukluar, pg.namalengkap AS perujuk,
                         pg2.namalengkap AS dokterrad, pr.namaproduk, pd.noregistrasi, pg2.nippns, pg2.id AS pgid, so.expertise, so.tanggal_terima, so.tanggal_jawab, so.topologi, so.morfologi, so.nomorpa
FROM            hasilpemeriksaanlab_t AS so INNER JOIN
                         pasiendaftar_t AS pd ON pd.norec = so.noregistrasifk INNER JOIN
                         pasien_m AS ps ON ps.id = pd.nocmfk INNER JOIN
                         kelompokpasien_m AS kp ON kp.id = pd.objectkelompokpasienlastfk INNER JOIN
                         ruangan_m AS ru ON ru.id = pd.objectruanganlastfk INNER JOIN
                         pelayananpasien_t AS pp ON pp.norec = so.pelayananpasienfk INNER JOIN
                         produk_m AS pr ON pr.id = pp.produkfk LEFT OUTER JOIN
                         jeniskelamin_m AS jk ON jk.id = ps.objectjeniskelaminfk LEFT OUTER JOIN
                         kelompokpasien_m AS kps ON kps.id = pd.objectkelompokpasienlastfk LEFT OUTER JOIN
                         alamat_m AS alm ON alm.nocmfk = ps.id LEFT OUTER JOIN
                         desakelurahan_m AS ds ON ds.id = alm.objectdesakelurahanfk LEFT OUTER JOIN
                         kotakabupaten_m AS kk ON kk.id = alm.objectkotakabupatenfk LEFT OUTER JOIN
                         kecamatan_m AS kc ON kc.id = alm.objectkecamatanfk LEFT OUTER JOIN
                         propinsi_m AS pro ON pro.id = alm.objectpropinsifk LEFT OUTER JOIN
                         pegawai_m AS pg ON pg.id = pd.objectpegawaifk LEFT OUTER JOIN
                         pegawai_m AS pg2 ON pg2.id = so.pegawaifk LEFT OUTER JOIN
                         pegawai_m AS pg3 ON pg3.id = so.dokterperujuk
WHERE        (so.norec =$P{norec}) AND (so.statusenabled = 'y')]]>
	</queryString>
