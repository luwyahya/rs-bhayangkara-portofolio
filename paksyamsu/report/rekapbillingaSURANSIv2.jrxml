	<queryString language="SQL">
		<![CDATA[select y.jenisproduk,
	y.dokter,
	y.noregistrasi,
	sum(y.total) as total,
	convert(varchar,y.tglregistrasi,20) AS tglregistrasi,
	convert(varchar,y.tglpulang,20) AS tglpulang,
	y.namarekanan,
	y.tipepasien,
	y.dokterpj,
	y.totalharusdibayar,
	sum(y.diskon) as diskon
from (select * from(
select row_number() over (partition by norec_pp order by kodeexternal ) as rownum ,* from v_jimat where noregistrasi= $P{noregistrasi}) as x
where rownum =1) as y
group by
y.jenisproduk,
y.dokter,
y.noregistrasi,
y.tglregistrasi,
y.tglpulang,
y.namarekanan,
y.tipepasien,
y.dokterpj,
y.totalharusdibayar
ORDER BY
	y.jenisproduk]]>
	</queryString>
