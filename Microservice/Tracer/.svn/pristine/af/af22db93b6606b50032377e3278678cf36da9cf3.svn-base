Private Sub Form_Load()
'On Error GoTo errLoad
    Dim adocomd As New ADODB.Command
    
    Set frm_cetak_label_viewer3 = Nothing
   ' Screen.MousePointer = vbHourglass
    Screen.MousePointer = vbDefault
    Me.WindowState = 2
'    Call openConnection

    strSQL = "SELECT MessageToDay FROM MasterDataPendukung"
    Call msubRecFO(rs, strSQL)

    strSQL = "Select Value from SettingGlobal Where Prefix ='KdRuanganPoliMCU'"
    Call msubRecFO(rs6, strSQL)
    If rs6.EOF = True Then Exit Sub
    
    
    adocomd.ActiveConnection = dbConn
    If rs6.Fields("Value") <> strKdRuanganTujuan Then
    
        If (mstrKdInstalasi = "02") Or (mstrKdInstalasi = "11") Or (mstrKdInstalasi = "06") Or (mstrKdInstalasi = "09") Or (mstrKdInstalasi = "10") Or (mstrKdInstalasi = "01") Or (mstrKdInstalasi = "22") Or (mstrKdInstalasi = "16") Then
    '        adocomd.CommandText = "SELECT * from V_CetakLabelRegistrasiPasienMRS " _
    '        & " WHERE (NoPendaftaran) =('" & mstrNoPen & "')"
            adocomd.CommandText = "SELECT * from V_CetakLabelRegistrasiPasienMRS_New " _
                                  & " WHERE (NoPendaftaran) =('" & mstrNoPen & "') " 'and TglMasuk = '" & Format(dTglDaftar, "yyyy/MM/dd hh:mm:ss") & "'"
    
        Else
            adocomd.CommandText = "SELECT * from V_CetakLabelRegistrasiPasienRI " _
            & " WHERE NoPendaftaran ='" & mstrNoPen & "'"
        End If
    Else
            adocomd.CommandText = "SELECT * from V_CetakLabelRegistrasiPasienMRSPaket " _
                                  & " WHERE (NoPendaftaran) =('" & mstrNoPen & "') " 'and TglMasuk = '" & Format(dTglDaftar, "yyyy/MM/dd hh:mm:ss") & "'"

    End If
    adocomd.CommandType = adCmdText

    Report.Database.AddADOCommand dbConn, adocomd

    Dim tanggal As String
    tanggal = Format(TglPeriodeAwal, "MMMM yyyy")

    With Report
' untuk cetak 2 printer sekaligus
Dim tempPrint1 As String
Dim strDeviceName As String
Dim strDriverName As String
Dim strPort As String
Dim Posisi, Z, Urutan As Integer

Dim sPrinter1 As String
Dim sPrinter2, sPrinter3 As String
    
    sPrinter2 = GetStringValue("HKEY_CURRENT_USER\Software\Medifirst2000\Medifirst2000", "PrinterLabel1")
    If sPrinter2 = "Error" Then
        sPrinter2 = ""
       Else
        sPrinter2 = sPrinter2 & ";"
    End If
    
    sPrinter3 = GetStringValue("HKEY_CURRENT_USER\Software\Medifirst2000\Medifirst2000", "PrinterLabel2")
    If sPrinter3 = "Error" Then
        sPrinter3 = ""
       Else
        sPrinter3 = sPrinter3 & ";"
    End If
    
    
    sPrinter1 = GetStringValue("HKEY_CURRENT_USER\Software\Medifirst2000\Medifirst2000", "PrinterLabel1") & ";"
    'Antisipasi titik koma double
    sPrinter1 = Replace(sPrinter1, ";;", ";")
    If sPrinter2 <> "" Or sPrinter3 <> "" Then
      sPrinter1 = sPrinter2 & "" & sPrinter3
    Else
        sPrinter1 = "Error"
    End If
    If sPrinter1 <> "Error" Then
        Urutan = 0
        For Z = 1 To Len(sPrinter1)
            If Mid(sPrinter1, Z, 1) = ";" Then
                Urutan = Urutan + 1
                Posisi = Z
                ReDim Preserve arrPrinter(Urutan)
                arrPrinter(Urutan).intUrutan = Urutan
                arrPrinter(Urutan).intPosisi = Posisi
                If Urutan = 1 Then
                    arrPrinter(Urutan).strNamaPrinter = Mid(sPrinter1, 1, Z - 1)
                Else
                    arrPrinter(Urutan).strNamaPrinter = Mid(sPrinter1, arrPrinter(Urutan - 1).intPosisi + 1, Z - arrPrinter(Urutan - 1).intPosisi - 1)
                End If
             
             
                For Each p In Printers
                        strDeviceName = arrPrinter(Urutan).strNamaPrinter
                        strDriverName = p.DriverName
                        strPort = p.Port
            
                        Report.SelectPrinter strDriverName, strDeviceName, strPort
                   
                        Report.PrintOut False, 2
                        Screen.MousePointer = vbNormal
    
                    Exit For
                Next
            End If
         Next Z
         
       Else ' jika printer belum di setting
       
        MsgBox "Printer belum di setting", vbExclamation, "informasi"
    End If
    Screen.MousePointer = vbNormal

    
End With

    Unload Me
'Exit Sub
'
'errLoad:
'    Call msubPesanError

End Sub

Private Sub Form_Resize()
    CRViewer1.Top = 0
    CRViewer1.Left = 0
    CRViewer1.Width = ScaleWidth
    CRViewer1.Height = ScaleHeight
End Sub

Private Sub Form_Unload(Cancel As Integer)
    Set frm_cetak_label_viewer3 = Nothing
'    Call PostingHutangPenjaminPasien_AU(mstrNoPen, "U")
End Sub

